@model List<DeliFitWeb.Models.CarrinhoViewModel>

@{
    ViewData["Title"] = "Seus Carrinhos";
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">
        <main class="col-12 p-5 bg-light">
            <div class="container">

                <!-- HEADER -->
                <div class="d-flex align-items-center mb-4">
                    <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary me-3">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    <h2 class="fw-bold m-0">Seus Carrinhos</h2>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        Você ainda não possui carrinhos cadastrados.
                    </div>
                }
                else
                {
                    @foreach (var carrinho in Model)
                    {
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-body d-flex justify-content-between align-items-center">

                                <!-- INFO -->
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                         style="width:60px;height:60px;">
                                        <i class="bi bi-cart3 fs-3 text-muted"></i>
                                    </div>

                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            Carrinho #@carrinho.Id
                                        </h6>

                                        <p class="text-muted small mb-0">
                                            Cliente: @carrinho.Cliente?.Nome
                                        </p>

                                        <p class="text-muted small mb-0">
                                            Forma de pagamento:
                                            @{
                                                var fp = carrinho.FormaDePagamento switch
                                                {
                                                    "P" => "PIX",
                                                    "C" => "Cartão",
                                                    "D" => "Dinheiro",
                                                    _ => "Não definida"
                                                };
                                            }
                                            @fp
                                            • Frete: R$ @carrinho.ValorFrete.ToString("F2")
                                        </p>
                                    </div>
                                </div>

                                <!-- AÇÕES -->
                                <div class="d-flex align-items-center gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@carrinho.Id"
                                       class="btn btn-outline-secondary btn-sm action-btn">
                                        <i class="bi bi-eye me-1"></i> Detalhes
                                    </a>

                                    <form asp-action="Delete" method="post" class="d-inline">
                                        <input type="hidden" name="Id" value="@carrinho.Id" />
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm btn-cancel"
                                                data-bs-id="@carrinho.Id"
                                                data-bs-nome="@carrinho.Cliente?.Nome">
                                            <i class="bi bi-trash me-1"></i> Cancelar
                                        </button>
                                    </form>

                                </div>

                            </div>
                        </div>
                    }
                }

                <!-- NOVO CARRINHO -->
                <div class="mt-4 text-center">
                    <a asp-action="Create"
                       class="btn px-4 py-2 fw-bold"
                       style="background-color:#ff6600;color:white;border-radius:30px;">
                        Criar novo carrinho
                    </a>
                </div>

            </div>
        </main>
    </div>
</div>


<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmDeleteLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Cancelar carrinho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Você está prestes a cancelar o <strong id="modalCarrinhoId">#0</strong>.</p>
                <p class="text-muted small mb-0" id="modalClienteNome"></p>
                <p class="small text-muted mt-2">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Confirmar cancelamento</button>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
      
        if (typeof bootstrap === 'undefined') {
            console.warn('Bootstrap JS não encontrado. A confirmação estilizada requer Bootstrap JavaScript.');
            return;
        }

        let currentForm = null;
        const modalEl = document.getElementById('confirmDeleteModal');
        const modal = new bootstrap.Modal(modalEl);

        document.querySelectorAll('.btn-cancel').forEach(function (btn) {
            btn.addEventListener('click', function () {
                currentForm = this.closest('form');
                const id = this.getAttribute('data-bs-id') || '';
                const nome = this.getAttribute('data-bs-nome') || '';

                document.getElementById('modalCarrinhoId').textContent = '#' + id;
                document.getElementById('modalClienteNome').textContent = nome ? 'Cliente: ' + nome : '';

                modal.show();
            });
        });

        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            if (currentForm) {
                
                currentForm.submit();
            }
        });
    });
</script>