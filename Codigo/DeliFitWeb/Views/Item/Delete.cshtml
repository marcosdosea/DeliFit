@model DeliFitWeb.Models.ItemViewModel

@{
    ViewData["Title"] = "Excluir Item";
    var idRestauranteContexto = Model.IdRestaurante;
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">


        <main class="col-md-10 p-5 bg-light">
            <div class="row justify-content-center">
                <div class="col-lg-10">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold text-danger m-0">Confirmar Exclus�o</h2>
                            <p class="text-muted">Revise os detalhes do prato antes de remov�-lo definitivamente.</p>
                        </div>
                        <span class="badge bg-white text-danger border border-danger p-2 px-3 shadow-sm">A��o Irrevers�vel</span>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-7 border-end">
                                    <label class="small fw-bold text-muted text-uppercase mb-1">Item selecionado</label>
                                    <h3 class="fw-bold text-dark mb-2">@Model.Nome</h3>
                                    <p class="text-muted mb-3 fst-italic">"@Model.Descricao"</p>

                                    <div class="d-flex gap-4">
                                        <div>
                                            <label class="small fw-bold text-muted d-block">PRE�O</label>
                                            <span class="fs-4 fw-bold text-success">R$ @Model.Preco.ToString("N2")</span>
                                        </div>
                                        <div>
                                            <label class="small fw-bold text-muted d-block">CALORIAS</label>
                                            <span class="badge bg-light text-dark border p-2 mt-1">@Model.Calorias kcal</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5 ps-4">
                                    <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-clipboard-data me-2"></i>Resumo Nutricional</h6>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded text-center">
                                                <small class="d-block text-muted small">Prote�na</small>
                                                <span class="fw-bold">@(Model.Proteina?.ToString("N1") ?? "0")g</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-2 bg-light rounded text-center">
                                                <small class="d-block text-muted small">Carbos</small>
                                                <span class="fw-bold">@(Model.Carboidratos?.ToString("N1") ?? "0")g</span>
                                            </div>
                                        </div>
                                    </div>
                                    @if (Model.CategoriaNomes.Any())
                                    {
                                        <div class="mt-3 p-2 bg-warning-subtle text-warning-emphasis rounded small fw-bold text-center border border-warning-subtle">
                                            <i class="bi bi-patch-exclamation me-1"></i> @string.Join(", ", Model.CategoriaNomes)
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" id="deleteForm">
                        <input type="hidden" asp-for="Id" />
                        @* Importante para o redirecionamento ap�s exclus�o *@
                        <input type="hidden" asp-for="IdRestaurante" />

                        <div class="card border-0 shadow-sm mb-4 bg-danger-subtle border-start border-danger border-5">
                            <div class="card-body d-flex align-items-center p-4">
                                <div class="form-check p-0 ms-2">
                                    <input class="form-check-input ms-0 me-3 shadow-none custom-checkbox" type="checkbox" id="confirmDelete" required style="width: 25px; height: 25px; cursor: pointer;">
                                    <label class="form-check-label fw-bold text-danger-emphasis pt-1" for="confirmDelete" style="cursor: pointer;">
                                        Eu entendo que excluir "@Model.Nome" apagar� permanentemente todos os seus dados nutricionais e de card�pio.
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" asp-route-idRestaurante="@idRestauranteContexto" class="btn btn-light px-4 fw-bold border text-muted shadow-sm">
                                <i class="bi bi-x-lg me-2"></i>Cancelar e Sair
                            </a>
                            <button type="submit" id="deleteButton" class="btn btn-danger px-5 fw-bold shadow-sm" disabled>
                                <i class="bi bi-trash3-fill me-2"></i>Confirmar Exclus�o
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    /* Estiliza��o customizada para a confirma��o */
    .bg-danger-subtle {
        background-color: #fdf2f2 !important;
    }

    .text-danger-emphasis {
        color: #852d2d !important;
    }

    .custom-checkbox:checked {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
    }

    #deleteButton:disabled {
        opacity: 0.5;
        filter: grayscale(1);
        cursor: not-allowed;
    }

    /* Feedback visual ao habilitar o bot�o */
    #deleteButton:not(:disabled) {
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkbox = document.getElementById('confirmDelete');
            const btn = document.getElementById('deleteButton');
            const form = document.getElementById('deleteForm');

            // Habilita o bot�o conforme o checkbox
            checkbox.addEventListener('change', function() {
                btn.disabled = !this.checked;
            });

            // Confirma��o via JS antes do submit final
            form.addEventListener('submit', function(e) {
                if (!confirm('Esta a��o � definitiva. Deseja prosseguir com a remo��o?')) {
                    e.preventDefault();
                } else {
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Removendo...';
                    btn.classList.add('disabled');
                }
            });
        });
    </script>
}