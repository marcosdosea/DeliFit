@model DeliFitWeb.Models.ItemViewModel

@{
    ViewData["Title"] = "Detalhes do Item";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header text-white" style="background-color: #ff6600;">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Detalhes do Item
                </h4>
                <a href="javascript:history.back()" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-4 d-flex align-items-center justify-content-center mb-4 mb-md-0">
                    @if (Model.Foto != null && Model.Foto.Length > 0)
                    {
                        <img src="@Url.Action("Foto", "Item", new { id = Model.Id })"
                             alt="Foto de @Model.Nome"
                             class="img-fluid rounded shadow-sm"
                             style="max-height: 280px; object-fit: contain; border: 2px solid #f0f0f0;" />
                    }
                    else
                    {
                        <div class="rounded d-flex flex-column align-items-center justify-content-center bg-light border"
                             style="width: 100%; height: 220px;">
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            <small class="text-muted mt-2">Sem foto cadastrada</small>
                        </div>
                    }
                </div>

                <div class="col-md-8">
                    <h5 class="text-primary mb-3">Informa��es do Produto</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Nome</label>
                        <p class="fs-5">@Model.Nome</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Descricao))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Descri��o</label>
                            <p class="text-muted">@Model.Descricao</p>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Pre�o</label>
                        <p class="fs-4 text-success">R$ @Model.Preco.ToString("N2")</p>
                    </div>

                    <div class="row g-3">
                        @if (!string.IsNullOrEmpty(Model.Tamanho))
                        {
                            <div class="col-auto">
                                <label class="form-label fw-bold text-muted">Tamanho</label>
                                <p><i class="bi bi-rulers me-2 text-primary"></i>@Model.Tamanho</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Volume))
                        {
                            <div class="col-auto">
                                <label class="form-label fw-bold text-muted">Volume</label>
                                <p><i class="bi bi-cup me-2 text-primary"></i>@Model.Volume</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Restricao))
                        {
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted">Restri��es Alimentares</label>
                                <div>
                                    <span class="badge bg-info fs-6 py-2 px-3">
                                        <i class="bi bi-shield-exclamation me-1"></i>@Model.Restricao
                                    </span>
                                </div>
                            </div>
                        }

                        @if (Model.CategoriaNomes.Any())
                        {
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted">Categorias</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var categoria in Model.CategoriaNomes)
                                    {
                                        <span class="badge bg-secondary fs-6 py-2 px-3">
                                            <i class="bi bi-tag me-1"></i>@categoria
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <h5 class="text-primary mb-3">Informa��es Nutricionais</h5>

                    <div class="row g-3">

                        <div class="col-md-3 col-sm-6">
                            <div class="card bg-info bg-opacity-10 border-info h-100">
                                <div class="card-body text-center d-flex flex-column justify-content-center">
                                    <h6 class="text-muted mb-2">Calorias</h6>
                                    <h3 class="text-primary mb-1">@Model.Calorias.ToString("N0")</h3>
                                    <small class="text-muted">kcal</small>
                                </div>
                            </div>
                        </div>

                        @if (Model.Proteina.HasValue)
                        {
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-success bg-opacity-10 border-success h-100">
                                    <div class="card-body text-center d-flex flex-column justify-content-center">
                                        <h6 class="text-muted mb-2">Prote�nas</h6>
                                        <h3 class="text-success mb-1">@Model.Proteina.Value.ToString("N1")</h3>
                                        <small class="text-muted">gramas</small>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.Carboidratos.HasValue)
                        {
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-warning bg-opacity-10 border-warning h-100">
                                    <div class="card-body text-center d-flex flex-column justify-content-center">
                                        <h6 class="text-muted mb-2">Carboidratos</h6>
                                        <h3 class="text-warning mb-1">@Model.Carboidratos.Value.ToString("N1")</h3>
                                        <small class="text-muted">gramas</small>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.Gordura.HasValue)
                        {
                            <div class="col-md-3 col-sm-6">
                                <div class="card bg-danger bg-opacity-10 border-danger h-100">
                                    <div class="card-body text-center d-flex flex-column justify-content-center">
                                        <h6 class="text-muted mb-2">Gorduras</h6>
                                        <h3 class="text-danger mb-1">@Model.Gordura.Value.ToString("N1")</h3>
                                        <small class="text-muted">gramas</small>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>�ltima atualiza��o: @DateTime.Now.ToString("dd/MM/yyyy")
            </small>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
        </div>
    </div>
</div>

<style>
    .card { border-radius: 10px; }

    .card .card {
        transition: transform 0.2s;
        min-height: 120px;
    }

    .card .card:hover { transform: translateY(-3px); }

    .card-header { background-color: #ff6600; }
</style>
