@model IEnumerable<DeliFitWeb.Models.ItemViewModel>

@{
    ViewData["Title"] = "Gestor de Cardápio";
    // Capturamos o ID da URL para garantir a consistência da navegação
    var idRestauranteContexto = Context.Request.Query["idRestaurante"];
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">

        <main class="col-md-10 p-5">
            <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
                <div>
                    <h2 class="fw-bold m-0">Gestor de Cardápio</h2>
                </div>

                <a asp-action="Create" asp-route-idRestaurante="@idRestauranteContexto"
                   class="btn fw-bold text-white px-4 shadow-sm" style="background-color: #ff6600; border: none;">
                    <i class="bi bi-plus-lg me-2"></i>Novo Item
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 border rounded bg-light shadow-sm">
                    <i class="bi bi-basket2 fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">Ainda não há itens cadastrados para este restaurante.</p>
                </div>
            }
            else
            {
                <div class="list-group shadow-sm border-top border-bottom">
                    @foreach (var item in Model)
                    {
                        <div class="list-group-item list-group-item-action p-4 border-start-0 border-end-0">
                            <div class="row align-items-center">
                                <div class="col-md-5">
                                    <h5 class="fw-bold mb-1 text-dark">@item.Nome</h5>
                                    <p class="text-muted small mb-0 text-truncate">@item.Descricao</p>
                                </div>

                                <div class="col-md-3">
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-light text-dark border fw-normal shadow-sm">@item.Calorias kcal</span>
                                        <span class="badge bg-light text-dark border fw-normal shadow-sm">@item.Proteina g Prot.</span>
                                    </div>
                                </div>

                                <div class="col-md-2 text-center border-start border-end">
                                    <span class="fw-bold fs-5" style="color: #ff6600;">R$ @item.Preco</span>
                                </div>

                                <div class="col-md-2 text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<style>
    /* Ajustes para suavizar a lista e evitar que fique torto */
    .list-group-item {
        border-color: #f0f0f0;
        transition: all 0.2s ease;
    }

        .list-group-item:hover {
            background-color: #fffaf5;
            border-left: 4px solid #ff6600 !important;
        }
</style>