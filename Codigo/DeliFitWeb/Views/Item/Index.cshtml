@model IEnumerable<DeliFitWeb.Models.ItemViewModel>

@{
    ViewData["Title"] = "Gestor de Cardápio";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestor de Cardápio</h1>
       <a asp-action="Create"
           asp-route-idRestaurante="@Context.Request.Query["idRestaurante"]" class="btn btn-dark">
            <i class="bi bi-plus-circle"></i> Novo Item
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhum item encontrado no cardápio. <a asp-action="Create">Adicione seu primeiro item</a>.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-0 text-primary">@Html.DisplayFor(modelItem => item.Nome)</h5>
                                <span class="badge bg-primary">ID: @Html.DisplayFor(modelItem => item.Id)</span>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Informações nutricionais -->
                            <div class="nutrition-info mb-3">
                                <h6 class="text-muted mb-2">Informações Nutricionais</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="nutrition-card bg-info bg-opacity-10 p-2 rounded">
                                            <small class="text-muted d-block">Calorias</small>
                                            <strong>@Html.DisplayFor(modelItem => item.Calorias) kcal</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="nutrition-card bg-success bg-opacity-10 p-2 rounded">
                                            <small class="text-muted d-block">Proteínas</small>
                                            <strong>@(item.Proteina?.ToString("F1") ?? "N/A") g</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="nutrition-card bg-warning bg-opacity-10 p-2 rounded">
                                            <small class="text-muted d-block">Carboidratos</small>
                                            <strong>@(item.Carboidratos?.ToString("F1") ?? "N/A") g</strong>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="nutrition-card bg-danger bg-opacity-10 p-2 rounded">
                                            <small class="text-muted d-block">Gorduras</small>
                                            <strong>@(item.Gordura?.ToString("F1") ?? "N/A") g</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Descrição e detalhes -->
                            @if (!string.IsNullOrEmpty(item.Descricao))
                            {
                                <p class="card-text text-muted small">
                                    @Html.DisplayFor(modelItem => item.Descricao)
                                </p>
                            }

                            <div class="item-details mt-3">
                                <div class="row">
                                    <div class="col-12 mb-2">
                                        <span class="text-muted">Preço:</span>
                                        <span class="fw-bold text-success">R$ @Html.DisplayFor(modelItem => item.Preco)</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Tamanho))
                                    {
                                        <div class="col-6">
                                            <span class="text-muted">Tamanho:</span>
                                            <span class="fw-bold">@Html.DisplayFor(modelItem => item.Tamanho)</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Volume))
                                    {
                                        <div class="col-6">
                                            <span class="text-muted">Volume:</span>
                                            <span class="fw-bold">@Html.DisplayFor(modelItem => item.Volume)</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Restrições -->
                            @if (!string.IsNullOrEmpty(item.Restricao))
                            {
                                <div class="mt-3">
                                    <small class="text-muted d-block">Restrições:</small>
                                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Restricao)</span>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    Restaurante: @Html.DisplayFor(modelItem => item.IdRestaurante)
                                </small>
                                <div class="btn-group">
                                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                                    @Html.ActionLink("Detalhes", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-info" })
                                    @Html.ActionLink("Excluir", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .nutrition-card {
        transition: transform 0.2s;
    }

        .nutrition-card:hover {
            transform: translateY(-2px);
        }

    .card {
        transition: all 0.3s ease;
        border: 1px solid #e0e0e0;
    }

        .card:hover {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            transform: translateY(-3px);
        }

    .nutrition-info h6 {
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 5px;
    }
</style>