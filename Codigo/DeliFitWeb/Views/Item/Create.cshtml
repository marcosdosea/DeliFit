@model DeliFitWeb.Models.ItemViewModel

@{
    ViewData["Title"] = "Novo Item";
    // Captura o ID do restaurante da URL para manter o v�nculo na cria��o
    var idRestauranteContexto = Context.Request.Query["idRestaurante"];
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">

        <main class="col-md-10 p-5 bg-light">
            <div class="row justify-content-center">
                <div class="col-lg-11">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold m-0">Novo Item</h2>
                            <p class="text-muted">Adicione um novo prato ou bebida ao seu card�pio.</p>
                        </div>
                    </div>

                    @* Mensagens de sucesso/erro *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        @* ID do Restaurante vinculado automaticamente *@
                        <input type="hidden" asp-for="IdRestaurante" />

                        <div class="row g-4">

                            <div class="col-md-8">

                                <div class="card border-0 shadow-sm p-4 mb-4">
                                    <h5 class="fw-bold mb-4" style="color: #ff6600;"><i class="bi bi-info-circle me-2"></i>Informa��es B�sicas</h5>

                                    <div class="mb-3">
                                        <label asp-for="Nome" class="form-label small fw-bold text-muted">NOME DO ITEM</label>
                                        <input asp-for="Nome" class="form-control border-0 bg-light p-3" placeholder="Ex: Salada Tropical" required />
                                        <span asp-validation-for="Nome" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Descricao" class="form-label small fw-bold text-muted">DESCRI��O DETALHADA</label>
                                        <textarea asp-for="Descricao" class="form-control border-0 bg-light p-3" rows="4" placeholder="Descreva os ingredientes e o preparo..."></textarea>
                                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <label asp-for="Preco" class="form-label small fw-bold text-muted">PRE�O DE VENDA (R$)</label>
                                            <div class="input-group">
                                                <span class="input-group-text border-0 bg-orange-subtle fw-bold" style="color: #ff6600;">R$</span>
                                                <input asp-for="Preco" type="number" step="0.01" class="form-control border-0 bg-light p-3" placeholder="0,00" required />
                                            </div>
                                            <span asp-validation-for="Preco" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-muted">CATEGORIAS</label>
                                            <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded">
                                                @{
                                                    var categoriasDisponiveis = ViewBag.CategoriasDisponiveis as IEnumerable<Core.Categoria> ?? new List<Core.Categoria>();
                                                }
                                                @foreach (var categoria in categoriasDisponiveis)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox"
                                                               name="CategoriaIds" value="@categoria.Id"
                                                               id="categoria_@categoria.Id"
                                                               @(Model.CategoriaIds.Contains(categoria.Id) ? "checked" : "") />
                                                        <label class="form-check-label" for="categoria_@categoria.Id">@categoria.Nome</label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm p-4 mb-4">
                                    <h5 class="fw-bold mb-4" style="color: #ff6600;"><i class="bi bi-image me-2"></i>Foto do Item</h5>

                                    <div class="mb-3">
                                        <label asp-for="FotoFile" class="form-label small fw-bold text-muted">
                                            SELECIONE UMA IMAGEM
                                            <span class="fw-normal text-muted">(opcional &middot; JPEG ou PNG &middot; m�x. 2 MB)</span>
                                        </label>
                                        <input asp-for="FotoFile"
                                               type="file"
                                               accept="image/jpeg,image/png"
                                               class="form-control border-0 bg-light p-3"
                                               onchange="previewFoto(this)" />
                                        <span asp-validation-for="FotoFile" class="text-danger small"></span>
                                    </div>

                                    <div id="previewContainer" class="d-none text-center mt-2">
                                        <img id="fotoPreview"
                                             src="#"
                                             alt="Pr�-visualiza��o"
                                             class="rounded"
                                             style="max-height: 200px; max-width: 100%; object-fit: contain; border: 2px dashed #ff6600;" />
                                    </div>
                                </div>

                            </div>

                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm p-4 mb-4 h-100">
                                    <h5 class="fw-bold mb-4" style="color: #ff6600;"><i class="bi bi-heart-pulse me-2"></i>Nutri��o e Medidas</h5>

                                    <div class="mb-3">
                                        <label asp-for="Calorias" class="form-label small fw-bold text-muted">CALORIAS (KCAL)</label>
                                        <input asp-for="Calorias" type="number" class="form-control border-0 bg-light p-3" placeholder="0" required />
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label asp-for="Proteina" class="form-label small fw-bold text-muted">PROT. (G)</label>
                                            <input asp-for="Proteina" type="number" step="0.1" class="form-control border-0 bg-light p-3" placeholder="0" />
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="Carboidratos" class="form-label small fw-bold text-muted">CARB. (G)</label>
                                            <input asp-for="Carboidratos" type="number" step="0.1" class="form-control border-0 bg-light p-3" placeholder="0" />
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Gordura" class="form-label small fw-bold text-muted">GORDURA (G)</label>
                                        <input asp-for="Gordura" type="number" step="0.1" class="form-control border-0 bg-light p-3" placeholder="0" />
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Tamanho" class="form-label small fw-bold text-muted">TAMANHO</label>
                                        <select asp-for="Tamanho" class="form-select border-0 bg-light p-3">
                                            <option value="">Nenhum (Vazio)</option>
                                            <option value="P">P - Pequeno</option>
                                            <option value="M">M - M�dio</option>
                                            <option value="G">G - Grande</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Volume" class="form-label small fw-bold text-muted">VOLUME</label>
                                        <input asp-for="Volume" class="form-control border-0 bg-light p-3" placeholder="Ex: 500ml" />
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between mt-4 pb-5">
                            <a asp-action="Index" asp-route-idRestaurante="@idRestauranteContexto" class="btn btn-outline-secondary px-4 fw-bold border-0">
                                <i class="bi bi-x-lg me-2"></i>Descartar
                            </a>
                            <button type="submit" class="btn text-white px-5 fw-bold shadow-sm" style="background-color: #ff6600; border: none;">
                                <i class="bi bi-plus-circle me-2"></i>Criar Item
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .bg-orange-subtle { background-color: #fff3e0; }

    .form-control:focus, .form-select:focus {
        background-color: #fdfdfd;
        box-shadow: 0 0 0 0.25rem rgba(255, 102, 0, 0.15);
        border: 1px solid #ff6600 !important;
    }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        function previewFoto(input) {
            const container = document.getElementById('previewContainer');
            const preview = document.getElementById('fotoPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                container.classList.add('d-none');
                preview.src = '#';
            }
        }
    </script>
}
