@model List<DeliFitWeb.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<style>
    body {
        background: #f8f9fa;
        padding-bottom: 90px;
    }

    .top-bar {
        background: white;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: sticky;
        top: 0;
        z-index: 200;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .back-btn {
        width: 38px;
        height: 38px;
        background: #f4f4f4;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #333;
        font-size: 1rem;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #ffe8d6;
            color: #ff6600;
        }

    .page-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .pedido-card {
        background: white;
        margin: 12px 16px 0;
        border-radius: 18px;
        padding: 16px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.07);
    }

    .pedido-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
    }

    .rest-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #f4f4f4;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .rest-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pedido-info {
        flex: 1;
        min-width: 0;
    }

    .pedido-code {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1a1a1a;
    }

    .pedido-rest {
        font-size: 0.78rem;
        color: #888;
        margin-top: 1px;
    }

    .pedido-status {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        white-space: nowrap;
    }

        .pedido-status.status-P {
            background: #fef9c3;
            color: #854d0e;
        }

        .pedido-status.status-E {
            background: #fff3e6;
            color: #ff6600;
        }

        .pedido-status.status-S {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .pedido-status.status-F {
            background: #dcfce7;
            color: #16a34a;
        }

    .pedido-divider {
        height: 1px;
        background: #f4f4f4;
        margin: 10px 0;
    }

    .pedido-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .pedido-valor {
        font-size: 0.95rem;
        font-weight: 800;
        color: #ff6600;
    }

    .pedido-data {
        font-size: 0.75rem;
        color: #aaa;
    }

    .pedido-btns {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-status {
        flex: 1;
        background: #ff6600;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        display: block;
    }

        .btn-status:hover {
            background: #e55a00;
            color: white;
            text-decoration: none;
        }

    .btn-repetir {
        flex: 1;
        background: white;
        color: #ff6600;
        border: 1.5px solid #ff6600;
        border-radius: 50px;
        padding: 10px;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        display: block;
    }

        .btn-repetir:hover {
            background: #fff3e6;
            color: #ff6600;
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #bbb;
    }

        .empty-state i {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
        }

    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 1px solid #f0f0f0;
        display: flex;
        z-index: 500;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
    }

    .nav-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8px 0 10px;
        gap: 3px;
        text-decoration: none;
        color: #aaa;
        font-size: 0.65rem;
        font-weight: 600;
        transition: color 0.15s;
    }

        .nav-item i {
            font-size: 1.3rem;
        }

        .nav-item.active {
            color: #ff6600;
        }

        .nav-item:hover {
            color: #ff6600;
            text-decoration: none;
        }
</style>

<div class="top-bar">
    <a asp-controller="Cliente" asp-action="HomeCliente" class="back-btn">
        <i class="bi bi-chevron-left"></i>
    </a>
    <span class="page-title">Meus Pedidos</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mx-3 mt-3 mb-0 rounded-3">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mx-3 mt-3 mb-0 rounded-3">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-bag-x"></i>
        <p style="font-weight:600; color:#555;">Você ainda não fez nenhum pedido</p>
        <a asp-controller="Cliente" asp-action="HomeCliente"
           class="btn mt-2"
           style="background:#ff6600; color:white; border-radius:30px; padding:12px 28px; font-weight:700;">
            Explorar restaurantes
        </a>
    </div>
}
else
{
    @foreach (var pedido in Model.OrderByDescending(p => p.Data))
    {
        var statusChar = pedido.Status?.ToString() ?? "P";
        var statusLabel = statusChar switch
        {
            "P" => "Pendente",
            "E" => "Em preparo",
            "S" => "Em entrega",
            "F" => "Entregue",
            _ => "Pendente"
        };

        <div class="pedido-card" data-pedido-id="@pedido.Id" data-status="@statusChar">
            <div class="pedido-header">
                <div class="rest-avatar">
                    <img src="@Url.Action("Foto", "Restaurante", new { id = pedido.IdRestaurante })"
                         alt="Restaurante"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;">
                        <i class="bi bi-shop" style="color:#ccc;font-size:1.4rem;"></i>
                    </div>
                </div>
                <div class="pedido-info">
                    <div class="pedido-code">Pedido #@pedido.Id</div>
                    <div class="pedido-rest">Restaurante #@pedido.IdRestaurante</div>
                </div>
                <span class="pedido-status status-@statusChar" id="badge-@pedido.Id">@statusLabel</span>
            </div>

            <div class="pedido-divider"></div>

            <div class="pedido-footer">
                <span class="pedido-data">
                    <i class="bi bi-calendar3 me-1"></i>
                    @pedido.Data?.ToString("dd/MM/yyyy HH:mm")
                </span>
                <span class="pedido-valor">R$ @pedido.Preco.ToString("N2")</span>
            </div>

            <div class="pedido-btns">
                <a asp-controller="Pedido" asp-action="Acompanhar"
                   asp-route-id="@pedido.Id"
                   class="btn-status">
                    <i class="bi bi-clock me-1"></i>Status do pedido
                </a>
                <a asp-controller="Restaurante" asp-action="VerEstabelecimento"
                   asp-route-id="@pedido.IdRestaurante"
                   class="btn-repetir">
                    <i class="bi bi-arrow-repeat me-1"></i>Repetir
                </a>
            </div>
        </div>
    }
}

<nav class="bottom-nav">
    <a asp-controller="Cliente" asp-action="HomeCliente" class="nav-item">
        <i class="bi bi-house-fill"></i>
        <span>Início</span>
    </a>
    <a asp-controller="Pedido" asp-action="Index" class="nav-item active">
        <i class="bi bi-bag-fill"></i>
        <span>Pedidos</span>
    </a>
    <a asp-controller="Cliente" asp-action="Perfil" class="nav-item">
        <i class="bi bi-person-fill"></i>
        <span>Consumo</span>
    </a>
    <a asp-controller="Categoria" asp-action="Index" class="nav-item">
        <i class="bi bi-grid-fill"></i>
        <span>Menu</span>
    </a>
</nav>

@section Scripts {
    <script>
        const STATUS_LABEL = {
            'P': 'Pendente',
            'E': 'Em preparo',
            'S': 'Em entrega',
            'F': 'Entregue'
        };

        const INTERVALO_MS = 10000; // polling a cada 10 segundos

        // Coleta apenas os pedidos ainda não finalizados para monitorar
        function coletarPedidosAtivos() {
            return Array.from(document.querySelectorAll('.pedido-card'))
                .filter(el => el.dataset.status !== 'F')
                .map(el => ({
                    id: el.dataset.pedidoId,
                    cardEl: el
                }));
        }

        function aplicarStatusNoBadge(cardEl, novoStatus) {
            const badge = cardEl.querySelector('.pedido-status');
            if (!badge) return;

            // Remove classes de status anteriores
            badge.classList.remove('status-P', 'status-E', 'status-S', 'status-F');
            badge.classList.add('status-' + novoStatus);
            badge.textContent = STATUS_LABEL[novoStatus] ?? novoStatus;

            // Atualiza data-status no card para excluir do próximo ciclo se finalizado
            cardEl.dataset.status = novoStatus;
        }

        async function consultarPedidosAtivos() {
            const ativos = coletarPedidosAtivos();
            if (ativos.length === 0) return; // todos finalizados, sem consultas

            await Promise.all(ativos.map(async ({ id, cardEl }) => {
                try {
                    const resp = await fetch(`/Pedido/GetStatus/${id}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!resp.ok) return;

                    const dados = await resp.json();
                    const novoStatus = (dados.status ?? 'P').toUpperCase();

                    if (novoStatus !== cardEl.dataset.status) {
                        aplicarStatusNoBadge(cardEl, novoStatus);
                    }
                } catch (_) {
                    // falha silenciosa; tenta no próximo ciclo
                }
            }));
        }

        let pollingTimer = null;

        function iniciarPolling() {
            consultarPedidosAtivos(); // consulta imediata ao abrir a tela
            pollingTimer = setInterval(consultarPedidosAtivos, INTERVALO_MS);
        }

        function pararPolling() {
            if (pollingTimer) {
                clearInterval(pollingTimer);
                pollingTimer = null;
            }
        }

        document.addEventListener('DOMContentLoaded', iniciarPolling);
        window.addEventListener('beforeunload', pararPolling);
    </script>
}