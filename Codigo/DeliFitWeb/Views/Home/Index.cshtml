@model DeliFitWeb.Models.RestauranteViewModel
@{
    ViewData["Title"] = "Perfil do Restaurante";
}

<div class="container-fluid">
    <div class="row">
        <!-- MENU LATERAL -->
        <aside class="col-md-2 border-end min-vh-100 p-3">
            <a asp-action="Index" class="text-decoration-none fw-bold">← Voltar</a>
            <ul class="nav flex-column mt-4 gap-2">
                <li class="nav-item fw-bold">Início</li>
                <li class="nav-item">Avaliações</li>
                <li class="nav-item">Pedidos</li>
                <li class="nav-item">Financeiro</li>
                <a asp-controller="Item" asp-action="Index" asp-route-idRestaurante="@Model.Id">
                    <li class="nav-item">Cardápio</li>
                </a>
                <li class="nav-item fw-bold text-primary">Perfil</li>
                <li class="nav-item">Configurações</li>
            </ul>
        </aside>

        <!-- CONTEÚDO PRINCIPAL -->
        <main class="col-md-10 p-4">
            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <div>
                    <h4 class="fw-bold">@Model.NomeRestaurante</h4>
                    <span class="badge @(Model.Validado ? "bg-success" : "bg-secondary")">
                        @(Model.Validado ? "Validado" : "Pendente")
                    </span>
                </div>
                <div>
                    <span class="me-3 fw-bold">4,4 ★</span>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">Editar</a>
                </div>
            </div>

            <!-- PERFIL -->
            <div class="row mb-4">
                <div class="col-md-3 text-center">
                    <div class="rounded-circle bg-light d-flex justify-content-center align-items-center" style="width:140px;height:140px;margin:auto;">
                        <i class="bi bi-person fs-1"></i>
                    </div>
                    <p class="mt-2 fw-bold">@Model.NomeProprietario</p>
                </div>
                <div class="col-md-9">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Telefone Restaurante</label>
                            <input class="form-control" value="@Model.TelefoneRestaurante" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Telefone Proprietário</label>
                            <input class="form-control" value="@Model.TelefoneProprietario" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Endereço</label>
                            <input class="form-control" value="@Model.Rua, @Model.Numero - @Model.Bairro, @Model.Cidade - @Model.Estado" disabled />
                        </div>
                    </div>
                </div>
            </div>

            <!-- DESCRIÇÃO -->
            <div class="mb-4">
                <label class="form-label fw-bold">Descrição</label>
                <textarea class="form-control" rows="5" disabled>@Model.Descricao</textarea>
            </div>

            <!-- AÇÕES -->
            <div class="text-end">
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Excluir Restaurante</a>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
}