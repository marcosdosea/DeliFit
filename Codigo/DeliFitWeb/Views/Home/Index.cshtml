@{
    ViewData["Title"] = "Painel Administrativo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Painel Geral</h2>
            <p class="text-muted">Bem-vindo, Administrador. Aqui está o resumo do DeliFit hoje.</p>
        </div>
        <button class="btn btn-primary">
            <i class="bi bi-download"></i> Relatório Geral
        </button>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-light-orange p-3 rounded">
                        <i class="bi bi-shop text-orange fs-3"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Restaurantes</h6>
                        <h4 class="fw-bold mb-0">128</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-light-orange p-3 rounded">
                        <i class="bi bi-people text-orange fs-3"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Usuários Ativos</h6>
                        <h4 class="fw-bold mb-0">1.2k</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-light-orange p-3 rounded">
                        <i class="bi bi-cart-check text-orange fs-3"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Pedidos (Hoje)</h6>
                        <h4 class="fw-bold mb-0">450</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-light-orange p-3 rounded">
                        <i class="bi bi-currency-dollar text-orange fs-3"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Faturamento</h6>
                        <h4 class="fw-bold mb-0">R$ 12k</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Novos Restaurantes Aguardando Aprovação</h5>
            <a href="#" class="btn btn-sm btn-outline-primary">Ver todos</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Restaurante</th>
                        <th>Proprietário</th>
                        <th>Cidade</th>
                        <th>Data Cadastro</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Fit & Sabor</strong></td>
                        <td>Ricardo Silva</td>
                        <td>Aracaju</td>
                        <td>12/01/2026</td>
                        <td><span class="badge bg-warning text-dark">Pendente</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                            <button class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Estilos específicos para esta página Index do ADM */
        .bg-light-orange {
            background-color: #fff3e6;
        }

        .text-orange {
            color: #ff6600;
        }

        .card {
            transition: transform 0.2s;
            border-radius: 12px;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .table thead th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
    </style>
}