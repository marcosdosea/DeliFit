@{
    ViewData["Title"] = "Painel Administrativo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Home</h2>
            <p class="text-muted">Bem-vindo, Administrador.</p>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Estilos específicos para esta página Index do ADM */
        .bg-light-orange {
            background-color: #fff3e6;
        }

        .text-orange {
            color: #ff6600;
        }

        .card {
            transition: transform 0.2s;
            border-radius: 12px;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .table thead th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
    </style>
}