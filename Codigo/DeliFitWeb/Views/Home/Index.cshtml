@{
    ViewData["Title"] = "Bem-vindo ao DeliFit";
}

<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="container text-center">

        <h1 class="display-4 fw-bold mb-3" style="color: #ff6600;">
            Bem-vindo ao DeliFit
        </h1>

        <p class="lead mb-5">
            Selecione o seu perfil para acessar o sistema:
        </p>

        <div class="row justify-content-center g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow-lg border-0">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title mb-3" style="color: #ff6600;">
                            🙋🏽‍♂️ Sou Cliente
                        </h3>
                        <p class="card-text text-muted mb-4">
                            Faça pedidos, acompanhe suas calorias e descubra novos restaurantes.
                        </p>
                        <div class="mt-auto">
                            <a href="/Identity/Account/Login?role=Cliente"
                               class="btn w-100 mb-2 text-white"
                               style="background-color: #ff6600;">
                                Entrar (Telefone/Email)
                            </a>
                            <a href="/Identity/Account/Register?role=Cliente"
                               class="btn w-100"
                               style="border: 2px solid #ff6600; color: #ff6600;">
                                Criar Conta Cliente
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-lg border-0">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title mb-3" style="color: #ff6600;">
                            🏪 Sou Restaurante
                        </h3>
                        <p class="card-text text-muted mb-4">
                            Gerencie seu cardápio, acompanhe pedidos e faturamento.
                        </p>
                        <div class="mt-auto">
                            <a href="/Identity/Account/Login?role=Restaurante"
                               class="btn w-100 mb-2 text-white"
                               style="background-color: #ff6600;">
                                Acessar Painel
                            </a>
                            <a href="/Restaurante/SolicitarAdesao"
                               class="btn w-100"
                               style="border: 2px solid #ff6600; color: #ff6600;">
                                Solicitar Adesão
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-lg border-0">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title mb-3" style="color: #ff6600;">
                            🛡️ Sou Admin
                        </h3>
                        <p class="card-text text-muted mb-4">
                            Gestão total da plataforma e aprovação de novos restaurantes.
                        </p>
                        <div class="mt-auto">
                            <a href="/Identity/Account/Login?role=Admin"
                               class="btn w-100 text-white"
                               style="background-color: #ff6600;">
                                Login Administrativo
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>