<!DOCTYPE html>
<html lang="pt-br">
<head>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliFit</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        :root {
            --delifit-orange: #ff6600;
            --delifit-dark-orange: #e65c00;
            --sidebar-width: 260px;
        }

        body {
            overflow-x: hidden;
            background-color: #f8f9fa;
        }

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background-color: #ffffff;
            border-right: 1px solid #dee2e6;
            padding: 20px 0;
            z-index: 1000;
            box-shadow: 2px 0 5px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: var(--delifit-orange) !important;
            text-align: center;
            display: block;
            margin-bottom: 10px;
            padding: 0 15px;
        }

        .login-area {
            padding: 0 20px 20px 20px;
            border-bottom: 1px solid #eee;
            margin-bottom: 15px;
        }

            .login-area a {
                display: block;
                padding: 6px 0;
                font-size: 0.9rem;
            }

        .nav-pills .nav-link {
            color: #495057;
            border-radius: 0 25px 25px 0;
            margin-right: 15px;
            padding: 12px 25px;
            transition: all 0.3s;
        }

            .nav-pills .nav-link:hover {
                background-color: #fff3e6;
                color: var(--delifit-orange);
            }

            .nav-pills .nav-link.active {
                background-color: var(--delifit-orange) !important;
                color: white !important;
            }

        .nav-link i {
            margin-right: 10px;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            padding: 30px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: var(--delifit-orange);
            text-decoration: none;
        }

            a:hover {
                color: var(--delifit-dark-orange);
            }

        .btn-primary {
            background-color: var(--delifit-orange);
            border-color: var(--delifit-dark-orange);
        }

            .btn-primary:hover {
                background-color: var(--delifit-dark-orange);
                border-color: #cc5200;
            }

        footer {
            margin-top: auto;
            padding: 20px 0;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
            }

            .nav-pills .nav-link {
                border-radius: 25px;
                margin: 5px 15px;
            }
        }
    </style>
</head>

<body>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="sidebar">

            <a class="navbar-brand"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-fire"></i> DeliFit
            </a>

            <div class="login-area">
                <partial name="_LoginPartial" />
            </div>

            <ul class="nav nav-pills flex-column">

                @* ================= ADMIN ================= *@
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "HomeAdmin" ? "active" : "")"
                           asp-controller="Restaurante" asp-action="HomeAdmin">
                            <i class="bi bi-house-door"></i> Início
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cliente" asp-action="Index">
                            <i class="bi bi-people"></i> Listar Clientes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Restaurante" asp-action="ListarSolicitacoes">
                            <i class="bi bi-clock-history"></i> Listar Solicitações
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Restaurante" asp-action="Index">
                            <i class="bi bi-shop"></i> Listar Restaurantes
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Cliente" asp-action="Create">
                            <i class="bi bi-person-plus"></i> Adicionar Cliente
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Restaurante" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> Adicionar Restaurante
                        </a>
                    </li>
                }

                @* ================= RESTAURANTE ================= *@
                @if (User.IsInRole("GerenteRestaurante"))
                {
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Restaurante" asp-action="Home">
                            <i class="bi bi-house-door"></i> Início
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="Index">
                            <i class="bi bi-journal-text"></i> Cardápio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Restaurante" asp-action="Edit">
                            <i class="bi bi-person"></i> Perfil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-headset"></i> Atendimento
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-credit-card"></i> Pagamentos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="bi bi-star"></i> Avaliações
                        </a>
                    </li>
                }

            </ul>
        </div>
    }

    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="border-top text-muted text-center">
            <div class="container">
                &copy; 2026 - <strong>DeliFit</strong> -
                <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>