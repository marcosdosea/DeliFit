    <!-- Validação de telefone --!>></>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- Máscara de telefone: formata visualmente como (99) 99999-9999 e envia apenas dígitos -->
    <script>
        (function($){
            function formatPhone(value){
                if(!value) return '';
                var v = value.replace(/\D/g,'').slice(0,11);
                if(v.length <= 2) return '(' + v;
                if(v.length <= 7) return '(' + v.slice(0,2) + ')' + v.slice(2);
                return '(' + v.slice(0,2) + ')' + v.slice(2,7) + '-' + v.slice(7);
            }

            $(function(){
                // Apply formatting on input for elements with class .telefone-mask
                $(document).on('input', '.telefone-mask', function(e){
                    var el = $(this);
                    var pos = this.selectionStart;
                    var old = el.val();
                    var formatted = formatPhone(old);
                    el.val(formatted);
                });

                // Before submit, normalize telefone inputs to digits only
                $(document).on('submit', 'form', function(){
                    $(this).find('.telefone-mask').each(function(){
                        var v = $(this).val() || '';
                        var digits = v.replace(/\D/g, '').slice(0,11);
                        $(this).val(digits);
                    });
                });
            });
        })(jQuery);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
