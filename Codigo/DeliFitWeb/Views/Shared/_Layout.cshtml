    <style>
        /* Variáveis de Cor DeliFit */
        :root {
            --delifit-orange: #ff6600;
            --delifit-dark-orange: #e65c00;
            --sidebar-width: 260px;
        }

        body {
            overflow-x: hidden;
            background-color: #f8f9fa;
        }

        /* Estrutura Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background-color: #ffffff;
            border-right: 1px solid #dee2e6;
            padding: 20px 0;
            z-index: 1000;
            box-shadow: 2px 0 5px rgba(0,0,0,0.05);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: var(--delifit-orange) !important;
            text-align: center;
            display: block;
            margin-bottom: 30px;
            padding: 0 15px;
        }

        /* Links do Menu */
        .nav-pills .nav-link {
            color: #495057;
            border-radius: 0 25px 25px 0;
            margin-right: 15px;
            padding: 12px 25px;
            transition: all 0.3s;
        }

        .nav-pills .nav-link:hover {
            background-color: #fff3e6;
            color: var(--delifit-orange);
        }

        .nav-pills .nav-link.active {
            background-color: var(--delifit-orange) !important;
            color: white !important;
        }

        .nav-link i {
            margin-right: 10px;
        }

        /* Área de Conteúdo Principal */
        .main-content {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Botões e Links Gerais */
        a {
            color: var(--delifit-orange);
            text-decoration: none;
        }

            a:hover {
                color: var(--delifit-dark-orange);
            }

        .btn-primary {
            background-color: var(--delifit-orange);
            border-color: var(--delifit-dark-orange);
        }

            .btn-primary:hover {
                background-color: var(--delifit-dark-orange);
                border-color: #cc5200;
            }

        footer {
            margin-top: auto;
            padding: 20px 0;
            font-size: 0.9rem;
        }

        /* Responsividade Básica */
        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
        }

            .main-content {
                margin-left: 0;
            }

            .nav-pills .nav-link {
                border-radius: 25px;
                margin: 5px 15px;
            }
        }
    </style>
</head>
