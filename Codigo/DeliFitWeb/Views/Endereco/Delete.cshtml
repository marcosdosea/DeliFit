@model DeliFitWeb.Models.EnderecoModel

@{
    ViewData["Title"] = "Excluir Endereço";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h2 class="fw-bold text-danger">DELIFIT</h2>
        <h4 class="text-muted">| Excluir Endereço |</h4>
        <div class="d-flex align-items-center">
            <span class="badge bg-secondary rounded-circle p-2 me-2">ADM</span>
            <span>Administrador</span>
        </div>
    </div>

    <div class="alert alert-danger shadow-sm d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-2 me-3"></i>
        <div>
            <h4 class="alert-heading fw-bold mb-1">Atenção! Zona de Perigo.</h4>
            <p class="mb-0">
                Você está prestes a excluir este endereço. Confira os dados abaixo antes de continuar.
            </p>
        </div>
    </div>

    <div class="card border-danger shadow-sm mb-4">
        <div class="card-header bg-danger text-white fw-bold">
            Revisão dos Dados
        </div>

        <div class="card-body">
            <h5 class="mb-3 text-decoration-underline text-secondary">
                Dados do Endereço
            </h5>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">CEP</label>
                    <p class="form-control-plaintext fw-bold">@Model.Cep</p>
                </div>

                <div class="col-md-5">
                    <label class="fw-bold text-muted small">Rua</label>
                    <p class="form-control-plaintext fw-bold">@Model.Rua</p>
                </div>

                <div class="col-md-2">
                    <label class="fw-bold text-muted small">Número</label>
                    <p class="form-control-plaintext">@Model.Numero</p>
                </div>

                <div class="col-md-2">
                    <label class="fw-bold text-muted small">Bairro</label>
                    <p class="form-control-plaintext">@Model.Bairro</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="fw-bold text-muted small">Cidade</label>
                    <p class="form-control-plaintext">@Model.Cidade</p>
                </div>

                <div class="col-md-2">
                    <label class="fw-bold text-muted small">Estado</label>
                    <p class="form-control-plaintext">@Model.Estado</p>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold text-muted small">Label</label>
                    <p class="form-control-plaintext">
                        @(string.IsNullOrWhiteSpace(Model.Label) ? "-" : Model.Label)
                    </p>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white d-flex justify-content-end align-items-center gap-3 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                Cancelar
            </a>

            <button type="button"
                    class="btn btn-danger px-4 fw-bold"
                    data-bs-toggle="modal"
                    data-bs-target="#modalConfirmacaoFinal">
                <i class="bi bi-trash"></i> Excluir Endereço
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacaoFinal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalLabel">
                    <i class="bi bi-shield-exclamation"></i> Confirmação de Segurança
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center py-4">
                <p class="fs-5 text-dark">
                    Tem certeza que deseja excluir este endereço?
                </p>
                <p class="text-danger small fw-bold mb-0">
                    <i class="bi bi-x-circle"></i> Esta ação é irreversível.
                </p>
            </div>

            <div class="modal-footer justify-content-center bg-light">
                <button type="button"
                        class="btn btn-secondary px-4"
                        data-bs-dismiss="modal">
                    Não, voltar
                </button>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        Sim, excluir definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
