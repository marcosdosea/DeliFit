@model DeliFitWeb.Models.ReclamacaoViewModel

@{
    ViewData["Title"] = "Problemas com Pedido";
    string nomeRestaurante = ViewBag.NomeRestaurante ?? "";
}

<style>
    body {
        background: #f8f9fa;
        padding-bottom: 40px;
    }

    .top-bar {
        background: white;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: sticky;
        top: 0;
        z-index: 200;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .back-btn {
        width: 38px;
        height: 38px;
        background: #f4f4f4;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #333;
        font-size: 1rem;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #fdecea;
            color: #e53e3e;
        }

    .page-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .section-card {
        background: white;
        margin: 16px;
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.07);
    }

    .section-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 14px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    /* ── Checkboxes de motivo ── */
    .motivo-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
    }

    .motivo-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1.5px solid #e8e8e8;
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        user-select: none;
    }

        .motivo-item:hover {
            border-color: #e53e3e;
            background: #fff5f5;
        }

        .motivo-item.selecionado {
            border-color: #e53e3e;
            background: #fff5f5;
        }

    .motivo-check {
        width: 20px;
        height: 20px;
        border: 2px solid #ccc;
        border-radius: 4px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        background: white;
    }

    .motivo-item.selecionado .motivo-check {
        background: #e53e3e;
        border-color: #e53e3e;
    }

        .motivo-item.selecionado .motivo-check::after {
            content: '✓';
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
        }

    .motivo-texto {
        font-size: 0.9rem;
        font-weight: 500;
        color: #333;
    }

    /* ── Textarea ── */
    .form-label-custom {
        font-size: 0.82rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 6px;
        display: block;
    }

    .form-textarea {
        width: 100%;
        border: 1.5px solid #e8e8e8;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 0.88rem;
        color: #333;
        resize: none;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
        background: #fafafa;
    }

        .form-textarea:focus {
            border-color: #e53e3e;
            background: white;
        }

    .char-count {
        text-align: right;
        font-size: 0.75rem;
        color: #bbb;
        margin-top: 4px;
    }

    .validation-msg {
        color: #e53e3e;
        font-size: 0.8rem;
        margin-top: 4px;
        display: block;
    }

    /* ── Botões ── */
    .btn-enviar {
        width: 100%;
        background: #e53e3e;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 15px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.2s;
    }

        .btn-enviar:hover {
            background: #c53030;
        }

    .btn-cancelar {
        width: 100%;
        background: white;
        color: #888;
        border: 1.5px solid #e8e8e8;
        border-radius: 50px;
        padding: 14px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-cancelar:hover {
            background: #f4f4f4;
            color: #555;
            text-decoration: none;
        }

    /* ── Modal M22 — Deseja Prosseguir? ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 20px;
        padding: 32px 24px;
        max-width: 320px;
        width: 90%;
        text-align: center;
        box-shadow: 0 8px 30px rgba(0,0,0,0.18);
    }

    .modal-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: #1a1a1a;
        margin-bottom: 24px;
    }

    .modal-btns {
        display: flex;
        gap: 12px;
    }

    .modal-btn-nao {
        flex: 1;
        background: white;
        color: #555;
        border: 1.5px solid #e8e8e8;
        border-radius: 10px;
        padding: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .modal-btn-nao:hover {
            background: #f4f4f4;
        }

    .modal-btn-sim {
        flex: 1;
        background: #e53e3e;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

        .modal-btn-sim:hover {
            background: #c53030;
        }
</style>

<div class="top-bar">
    <a asp-controller="Pedido" asp-action="Acompanhar" asp-route-id="@Model.IdPedido" class="back-btn">
        <i class="bi bi-chevron-left"></i>
    </a>
    <span class="page-title">Problemas com Pedido</span>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mx-3 mt-3 mb-0 rounded-3">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
    </div>
}

<form id="formReclamacao" asp-action="Reclamacao" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPedido" />
    <input type="hidden" id="motivoHidden" name="Motivo" value="" />

    <div class="section-card">
        <span class="section-label">Selecione uma opção:</span>

        <div class="motivo-list">
            <div class="motivo-item" data-motivo="Não recebi o pedido" onclick="selecionarMotivo(this)">
                <div class="motivo-check"></div>
                <span class="motivo-texto">Não recebi o pedido</span>
            </div>
            <div class="motivo-item" data-motivo="Pedido veio errado" onclick="selecionarMotivo(this)">
                <div class="motivo-check"></div>
                <span class="motivo-texto">Pedido veio errado</span>
            </div>
            <div class="motivo-item" data-motivo="Outro" onclick="selecionarMotivo(this)">
                <div class="motivo-check"></div>
                <span class="motivo-texto">Outro</span>
            </div>
        </div>

        <label class="form-label-custom" for="descricaoInput">Descreva o problema</label>
        <textarea id="descricaoInput"
                  asp-for="Descricao"
                  class="form-textarea"
                  rows="5"
                  maxlength="500"
                  placeholder="Descreva o que aconteceu..."></textarea>
        <div class="char-count"><span id="charCount">0</span>/500</div>
        <span asp-validation-for="Descricao" class="validation-msg"></span>

        <button type="button" class="btn-enviar" onclick="abrirModal()">
            <i class="bi bi-send-fill"></i>
            Enviar Reclamação
        </button>

        <a asp-controller="Cliente" asp-action="HomeCliente" class="btn-cancelar">
            <i class="bi bi-x-circle"></i>
            Cancelar
        </a>
    </div>
</form>

@* ── Modal M22 — Deseja Prosseguir? ── *@
<div class="modal-overlay" id="modalConfirm">
    <div class="modal-box">
        <div class="modal-title">Deseja Prosseguir?</div>
        <div class="modal-btns">
            <button type="button" class="modal-btn-nao" onclick="fecharModal()">Não</button>
            <button type="button" class="modal-btn-sim" onclick="confirmarEnvio()">Sim</button>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ── Contador de caracteres ──
        const textarea  = document.getElementById('descricaoInput');
        const charCount = document.getElementById('charCount');
        charCount.textContent = textarea.value.length;
        textarea.addEventListener('input', () => { charCount.textContent = textarea.value.length; });

        // ── Seleção de motivo (single-select via checkbox visual) ──
        function selecionarMotivo(el) {
            document.querySelectorAll('.motivo-item').forEach(i => i.classList.remove('selecionado'));
            el.classList.add('selecionado');
            document.getElementById('motivoHidden').value = el.dataset.motivo;
        }

        // ── Modal M22 ──
        function abrirModal() {
            const descricao = textarea.value.trim();
            if (descricao.length < 10) {
                textarea.focus();
                textarea.style.borderColor = '#e53e3e';
                return;
            }
            textarea.style.borderColor = '';
            document.getElementById('modalConfirm').classList.add('open');
        }

        function fecharModal() {
            document.getElementById('modalConfirm').classList.remove('open');
        }

        function confirmarEnvio() {
            // Prefixa a descrição com o motivo selecionado (se houver)
            const motivo = document.getElementById('motivoHidden').value;
            if (motivo && !textarea.value.startsWith('[' + motivo + ']')) {
                textarea.value = '[' + motivo + '] ' + textarea.value;
            }
            document.getElementById('formReclamacao').submit();
        }
    </script>
}