@model DeliFitWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Excluir Restaurante";
}

<div class="container mt-5">
 
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Excluir Restaurante</h2>
        </div>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                <i class="bi bi-chevron-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary"><i class="bi bi-person-badge me-2"></i>Informações do Proprietário</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small text-uppercase fw-bold text-muted">Nome Completo</label>
                            <p class="fs-5 text-dark border-bottom pb-1">@Model.NomeProprietario</p>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-uppercase fw-bold text-muted">E-mail de Contato</label>
                            <p class="fs-5 text-dark border-bottom pb-1">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-uppercase fw-bold text-muted">CPF</label>
                            <p class="text-dark">@Model.CpfProprietario</p>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-uppercase fw-bold text-muted">Telefone</label>
                            <p class="text-dark">@Model.TelefoneProprietario</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary"><i class="bi bi-shop me-2"></i>Dados do Estabelecimento</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="small text-uppercase fw-bold text-muted">Razão Social / Nome</label>
                            <p class="fs-4 fw-bold text-danger">@Model.NomeRestaurante</p>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <label class="small text-uppercase fw-bold text-muted d-block">CNPJ</label>
                            <span class="badge bg-outline-secondary border text-dark p-2">@Model.Cnpj</span>
                        </div>

                        <div class="col-12 mt-3">
                            <div class="p-3 bg-light rounded border">
                                <h6 class="small fw-bold text-uppercase text-muted mb-3"><i class="bi bi-geo-alt-fill me-1"></i> Localização</h6>
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <span class="d-block small text-muted">Endereço</span>
                                        <span>@Model.Rua, @Model.Numero - @Model.Bairro</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="d-block small text-muted">Cidade/UF</span>
                                        <span>@Model.Cidade / @Model.Estado</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-danger shadow-sm px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#modalConfirmacaoFinal">
                        <i class="bi bi-trash3-fill me-2"></i>Remover Restaurante
                    </button>
                </div>
            </div>
        </div>
    </div>
</div> 

<div class="modal fade" id="modalConfirmacaoFinal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-exclamation-circle text-danger display-1"></i>
                </div>
                <h3 class="fw-bold text-dark">Você tem certeza?</h3>
                <p class="text-muted mb-4">
                    Você está prestes a excluir <strong>@Model.NomeRestaurante</strong>.
                    <br><span class="text-danger fw-bold small">ESTA OPERAÇÃO NÃO PODE SER DESFEITA.</span>
                </p>

                <div class="d-grid gap-2">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold mb-2">Sim, excluir permanentemente</button>
                    </form>
                    <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Não, cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>