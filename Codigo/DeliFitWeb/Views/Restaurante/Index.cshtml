@model IEnumerable<DeliFitWeb.Models.RestauranteViewModel>

@{
    ViewData["Title"] = "Restaurante";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Restaurantes</h2>
            <p class="text-muted">Gerencie todos os estabelecimentos cadastrados na plataforma DeliFit.</p>
        </div>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                <i class="bi bi-chevron-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="solicitacoesTable" class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">ID</th>
                            <th class="py-3">Restaurante</th>
                            <th class="py-3">Localização</th>
                            <th class="py-3">Status</th>
                            <th class="text-center py-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light-orange rounded-circle me-3 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-shop text-orange"></i>
                                            </div>
                                            <span class="fw-bold">@item.NomeRestaurante</span>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="bi bi-geo-alt text-muted me-1"></i> @item.Cidade / @item.Estado
                                    </td>
                                    <td>
                                        @if (item.Validado)
                                        {
                                            <span class="badge rounded-pill bg-success-light text-success px-3">
                                                <i class="bi bi-check-circle-fill me-1"></i> Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-light text-secondary px-3">
                                                <i class="bi bi-pause-circle-fill me-1"></i> Inativo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-orange-outline px-3">
                                            Visualizar Restaurante
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            new DataTable('#restauranteTable', {
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/pt-BR.json',
                    emptyTable : "Nenhum restaurante encontrado."
                },
                pageLength: 8,
                lengthChange: false,
                ordering: true,
                info: true,
                searching: true,
                pagingType: "simple_numbers",
                dom:
                    "<'row mb-3'<'col-md-6'f><'col-md-6 text-end'i>>" +
                    "<'table-responsive'tr>" +
                    "<'row mt-3'<'col-md-12 d-flex justify-content-center'p>>"
            });
        });
    </script>


    <style>
        .text-orange {
            color: #ff6600 !important;
        }

        .bg-light-orange {
            background-color: #fff3e6;
        }

        .bg-success-light {
            background-color: #e6f4ea;
        }

        .bg-secondary-light {
            background-color: #f1f3f4;
        }

        .avatar-sm {
            width: 35px;
            height: 35px;
        }

        .btn-orange-outline {
            border: 1px solid #ff6600;
            color: #ff6600;
            background: transparent;
            transition: all 0.2s;
            font-weight: 500;
        }

            .btn-orange-outline:hover {
                background-color: #ff6600;
                color: white;
            }

        .btn-red-outline {
            border: 1px solid #ff0000;
            color: #ff0000;
            background: transparent;
            transition: all 0.2s;
            font-weight: 300;
        }

            .btn-red-outline:hover {
                background-color: #ff0000;
                color: white;
            }

        .table thead th {
            font-size: 0.85rem;
            color: #6c757d;
            border-bottom: 2px solid #f8f9fa;
        }

        .table tbody tr:hover {
            background-color: #fffaf5;
        }
        /* ===== DataTables DeliFit ===== */

        /* Search */
        .dataTables_filter input {
            border-radius: 20px;
            padding: 6px 14px;
            border: 1px solid #dee2e6;
            outline: none;
        }

            .dataTables_filter input:focus {
                border-color: #ff6600;
                box-shadow: 0 0 0 0.15rem rgba(255, 102, 0, 0.25);
            }

        /* Info */
        .dataTables_info {
            font-size: 0.85rem;
            color: #6c757d;
        }

        /* Paginação */
        .dataTables_paginate .pagination {
            gap: 6px;
        }

        .dataTables_paginate .page-link {
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ff6600;
            border: 1px solid #dee2e6;
        }

            .dataTables_paginate .page-link:hover {
                background-color: #fff3e6;
                border-color: #ff6600;
            }

        .dataTables_paginate .page-item.active .page-link {
            background-color: #ff6600;
            border-color: #ff6600;
            color: #fff;
        }

        /* Remove borda feia padrão */
        table.dataTable {
            border-collapse: separate;
            border-spacing: 0;
        }

            /* Hover alinhado com seu layout */
            table.dataTable tbody tr:hover {
                background-color: #fffaf5;
            }

            /* Cabeçalho */
            table.dataTable thead th {
                border-bottom: 2px solid #f8f9fa;
                color: #6c757d;
                font-size: 0.85rem;
            }

    </style>
}