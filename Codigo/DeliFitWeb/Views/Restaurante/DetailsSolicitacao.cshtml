@model DeliFitWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Detalhes do Restaurante - Solicitação";
}

<div class="container-fluid p-0">
    <div class="row g-0">

        <main class="col-md-12">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show m-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <div class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle border d-flex justify-content-center align-items-center" style="width:35px;height:35px;">
                        <span class="fw-bold small">R</span>
                    </div>
                    <span class="fw-bold">@Model.NomeRestaurante</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-clock-history me-1"></i> Pendente
                    </span>
                </div>
            </div>

            <div class="position-relative">
                <div class="w-100 bg-light d-flex justify-content-center align-items-center overflow-hidden" style="height: 180px; background: linear-gradient(to bottom, #f8f9fa, #e9ecef);">
                    <i class="bi bi-mountains display-1 text-secondary opacity-25"></i>
                </div>

                <div class="position-absolute translate-middle-y start-0 ms-5 shadow-sm rounded-circle bg-white border d-flex justify-content-center align-items-center" style="width: 120px; height: 120px; bottom: -40px;">
                    <span class="display-4 fw-bold text-orange" style="color: #ff9800;">R</span>
                </div>
            </div>

            <div class="px-5 pt-5 mt-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="flex-grow-1 row g-3">
                        <div class="col-md-5">
                            <label class="small fw-bold text-muted">Nome restaurante</label>
                            <input class="form-control bg-white" value="@Model.NomeRestaurante" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-muted">Telefone</label>
                            <input class="form-control bg-white" value="@Model.TelefoneRestaurante" disabled />
                        </div>
                        <div class="col-md-1 text-end pt-4">
                            <span class="fw-bold fs-5">-- <i class="bi bi-star text-warning"></i></span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-10">
                        <label class="small fw-bold text-muted">Endereço</label>
                        <input class="form-control bg-white" value="@Model.Rua, @Model.Numero, @Model.Bairro, @Model.Cidade - @Model.Estado" disabled />
                    </div>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-md-10">
                        <label class="small fw-bold text-muted">Descrição</label>
                        <textarea class="form-control bg-white" rows="4" disabled>@Model.Descricao</textarea>
                    </div>
                </div>

                <div class="text-end pe-5 pb-5">
                    <form asp-action="AprovarSolicitacao" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-5 fw-bold text-white shadow-sm">
                            <i class="bi bi-check-circle me-2"></i> Aprovar Solicitação
                        </button>
                    </form>

                    <form asp-action="NegarSolicitacao" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-5 fw-bold text-white shadow-sm ms-2">
                            <i class="bi bi-x-circle me-2"></i> Negar Solicitação
                        </button>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Confirmação para NEGAR (excluir)
            const negarForm = document.querySelector('form[action*="NegarSolicitacao"]');
            if (negarForm) {
                negarForm.addEventListener('submit', function(e) {
                    if (!confirm('Tem certeza que deseja NEGAR esta solicitação?\n\nO restaurante será EXCLUÍDO permanentemente.')) {
                        e.preventDefault();
                    }
                });
            }

            // Confirmação para APROVAR
            const aprovarForm = document.querySelector('form[action*="AprovarSolicitacao"]');
            if (aprovarForm) {
                aprovarForm.addEventListener('submit', function(e) {
                    if (!confirm('Tem certeza que deseja APROVAR esta solicitação?\n\nO restaurante será ativado e receberá um email com as credenciais de acesso.')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}