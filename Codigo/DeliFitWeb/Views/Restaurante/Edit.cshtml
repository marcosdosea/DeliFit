@model DeliFitWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Editar Restaurante";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h2 class="fw-bold">DELIFIT</h2>
        <h4 class="text-muted">| Editar Restaurante |</h4>
        <div class="d-flex align-items-center">
            <span class="badge bg-secondary rounded-circle p-2 me-2">ADM</span>
            <span>Administrador</span>
        </div>
    </div>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <input type="hidden" asp-for="Id" />

        <div class="card bg-light mb-4 border-secondary">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold mb-0">Situação do Cadastro</h6>
                    <small class="text-muted">Defina se este restaurante deve aparecer no sistema.</small>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="Validado" id="flexSwitchCheckChecked">
                    <label class="form-check-label fw-bold" for="flexSwitchCheckChecked">Cadastro Ativo</label>
                </div>
            </div>
        </div>

        <h5 class="mb-3 text-decoration-underline">Dados proprietário</h5>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="NomeProprietario" class="form-label"></label>
                <input asp-for="NomeProprietario" class="form-control" />
                <span asp-validation-for="NomeProprietario" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CpfProprietario" class="form-label"></label>
                <input asp-for="CpfProprietario" class="form-control" />
                <span asp-validation-for="CpfProprietario" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="TelefoneProprietario" class="form-label"></label>
                <input asp-for="TelefoneProprietario" class="form-control" />
                <span asp-validation-for="TelefoneProprietario" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <h5 class="mb-3 text-decoration-underline">Dados Restaurante</h5>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="NomeRestaurante" class="form-label"></label>
                <input asp-for="NomeRestaurante" class="form-control" />
                <span asp-validation-for="NomeRestaurante" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Cnpj" class="form-label"></label>
                <input asp-for="Cnpj" class="form-control" />
                <span asp-validation-for="Cnpj" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="TelefoneRestaurante" class="form-label"></label>
                <input asp-for="TelefoneRestaurante" class="form-control" />
                <span asp-validation-for="TelefoneRestaurante" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label asp-for="Cep" class="form-label"></label>
                <input asp-for="Cep" class="form-control" />
                <span asp-validation-for="Cep" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rua" class="form-label"></label>
                <input asp-for="Rua" class="form-control" />
                <span asp-validation-for="Rua" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Numero" class="form-label"></label>
                <input asp-for="Numero" class="form-control" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-5">
                <div class="col-md-6">
                    <label asp-for="Cidade" class="form-label"></label>
                    <input asp-for="Cidade" class="form-control" />
                    <span asp-validation-for="Cidade" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Bairro" class="form-label"></label>
                    <input asp-for="Bairro" class="form-control" />
                    <span asp-validation-for="Bairro" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="">Selecione...</option>
                        <option value="SP">São Paulo</option>
                        <option value="RJ">Rio de Janeiro</option>
                        <option value="MG">Minas Gerais</option>
                        <option value="SE">Sergipe</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-3">
            <a asp-action="Index" class="text-decoration-none text-secondary fw-bold">Cancelar</a>
            <button type="submit" class="btn btn-dark px-4 py-2">Salvar Alterações</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}