@model DeliFitWeb.Models.RestauranteModel

@{
    ViewData["Title"] = "Detalhes do Restaurante";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h2 class="fw-bold">DELIFIT</h2>
        <h4 class="text-muted">| Detalhes do Restaurante |</h4>
        <div class="d-flex align-items-center">
            <span class="badge bg-secondary rounded-circle p-2 me-2">ADM</span>
            <span>Administrador</span>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="d-flex justify-content-end mb-3">
                @if (Model.Validado)
                {
                    <span class="badge bg-success fs-6">Status: Ativo</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Status: Inativo</span>
                }
            </div>

            <h5 class="mb-3 text-decoration-underline text-primary">Dados do Proprietário</h5>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">Nome do Proprietário</label>
                    <p class="form-control-plaintext fs-5">@Model.NomeProprietario</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">CPF</label>
                    <p class="form-control-plaintext">@Model.CpfProprietario</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">Telefone</label>
                    <p class="form-control-plaintext">@Model.TelefoneProprietario</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <label class="fw-bold text-muted small">E-mail</label>
                    <p class="form-control-plaintext">@Model.Email</p>
                </div>
            </div>

            <hr class="text-muted" />

            <h5 class="mb-3 text-decoration-underline text-primary">Dados do Restaurante</h5>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">Nome do Restaurante</label>
                    <p class="form-control-plaintext fs-5">@Model.NomeRestaurante</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">CNPJ</label>
                    <p class="form-control-plaintext">@Model.Cnpj</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">Telefone Comercial</label>
                    <p class="form-control-plaintext">@Model.TelefoneRestaurante</p>
                </div>
            </div>

            <div class="bg-light p-3 rounded">
                <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt"></i> Endereço</h6>
                <div class="row">
                    <div class="col-md-2">
                        <label class="fw-bold text-muted small">CEP</label>
                        <p class="form-control-plaintext">@Model.Cep</p>
                    </div>
                    <div class="col-md-5">
                        <label class="fw-bold text-muted small">Rua</label>
                        <p class="form-control-plaintext">@Model.Rua</p>
                    </div>
                    <div class="col-md-2">
                        <label class="fw-bold text-muted small">Número</label>
                        <p class="form-control-plaintext">@Model.Numero</p>
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold text-muted small">Cidade / UF</label>
                        <p class="form-control-plaintext">@Model.Cidade / @Model.Estado</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer bg-white border-top-0 d-flex justify-content-end gap-2 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Voltar</a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4">
                Excluir
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark px-4">
                Editar Dados
            </a>
        </div>
    </div>
</div>