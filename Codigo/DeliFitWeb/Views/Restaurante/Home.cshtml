@{
    ViewData["Title"] = "Gestor de Pedidos";
}

<style>
    body {
        background: #f8f9fa;
    }

    .header-gestor {
        background: white;
        border-bottom: 1px solid #e9ecef;
        padding: 24px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .header-icon i {
        font-size: 28px;
        color: #333;
    }

    .header-text h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.3rem;
        color: #1a1a1a;
    }

    .header-text p {
        margin: 4px 0 0 0;
        font-size: 0.9rem;
        color: #888;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-badge.aberto {
        background: #dcfce7;
        color: #16a34a;
    }

    .status-badge.fechado {
        background: #fee2e2;
        color: #dc2626;
    }

    .btn-refresh {
        padding: 8px 16px;
        border-radius: 6px;
        border: 1px solid #ddd;
        background: white;
        color: #333;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-refresh:hover {
        border-color: #ff6600;
        color: #ff6600;
        background: #fff5f0;
    }

    .btn-fechar {
        padding: 8px 16px;
        border-radius: 6px;
        border: none;
        background: #fee2e2;
        color: #dc2626;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-fechar:hover {
        background: #fecaca;
    }

    .content-area {
        padding: 32px;
    }

    .metrics-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .metric-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #f0f0f0;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #888;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
        color: #ff6600;
    }

    .kanban-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        overflow-x: auto;
    }

    .kanban-column {
        display: flex;
        flex-direction: column;
    }

    .column-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .column-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
    }

    .column-count {
        background: #f0f0f0;
        color: #333;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .orders-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .order-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border: 1px solid #f0f0f0;
        transition: all 0.2s;
        cursor: pointer;
    }

    .order-card:hover {
        box-shadow: 0 4px 12px rgba(255,102,0,0.15);
        border-color: #ff6600;
        transform: translateY(-2px);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: #fafafa;
        border-bottom: 1px solid #f0f0f0;
    }

    .order-id {
        font-weight: 700;
        font-size: 0.95rem;
        color: #ff6600;
    }

    .order-time {
        font-size: 0.8rem;
        color: #888;
    }

    .order-body {
        padding: 12px 16px;
    }

    .order-client {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .order-address {
        font-size: 0.8rem;
        color: #888;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .order-price {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f0f0f0;
    }

    .order-actions {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        flex: 1;
        padding: 8px 12px;
        border-radius: 6px;
        border: none;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-view {
        background: #ff6600;
        color: white;
    }

    .btn-view:hover {
        background: #e55a00;
    }

    .btn-advance {
        background: #e3f2fd;
        color: #1976d2;
    }

    .btn-advance:hover {
        background: #bbdefb;
    }

    .btn-finalize {
        background: #dcfce7;
        color: #16a34a;
    }

    .btn-finalize:hover {
        background: #bbf7d0;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        text-align: center;
        color: #888;
    }

    .empty-icon {
        font-size: 2rem;
        margin-bottom: 12px;
        opacity: 0.4;
    }

    .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
        color: #888;
    }

    .spinner {
        border: 3px solid #f0f0f0;
        border-top: 3px solid #ff6600;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        animation: spin 1s linear infinite;
        margin-right: 8px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .header-gestor {
            flex-direction: column;
            gap: 16px;
            text-align: center;
        }

        .header-actions {
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        .kanban-container {
            grid-template-columns: 1fr;
            overflow-x: visible;
        }
    }
</style>

<div class="header-gestor">
    <div class="header-title">
        <div class="header-icon">
            <i class="bi bi-receipt"></i>
        </div>
        <div class="header-text">
            <h3>Gestor de Pedidos</h3>
            <p>Controle de pedidos em tempo real</p>
        </div>
    </div>

    <div class="header-actions">
        <span id="statusBadge" class="status-badge aberto">
            <i class="bi bi-circle-fill" style="font-size: 0.6rem; margin-right: 6px;"></i>
            Loja Aberta
        </span>

        <button id="btnRefresh" class="btn-refresh">
            <i class="bi bi-arrow-clockwise" style="margin-right: 6px;"></i>
            Atualizar
        </button>

        <button id="btnFechar" class="btn-fechar">
            <i class="bi bi-door-closed" style="margin-right: 6px;"></i>
            Fechar Loja
        </button>
    </div>
</div>

<div class="content-area">
    <!-- MÉTRICAS -->
    <div class="metrics-container" id="metricsContainer">
        <div class="metric-card">
            <div class="metric-label">Finalizados Hoje</div>
            <div class="metric-value" id="metricEntregas">0</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Pedidos Ativos</div>
            <div class="metric-value" id="metricAtivos">0</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Tempo Médio</div>
            <div class="metric-value" id="metricTempo">--</div>
        </div>
    </div>

    <!-- KANBAN -->
    <div class="kanban-container" id="kanbanContainer"></div>

    <div id="loadingContainer" class="loading" style="display: none;">
        <div class="spinner"></div>
        <span>Carregando pedidos...</span>
    </div>
</div>

@section Scripts {
    <script>
        // Mapeamento: índice numérico → label e cor da coluna do kanban
        // 0=RECEBIDO (P), 1=EM PREPARO (E), 2=EM ENTREGA (S)
        // Pedidos finalizados (F) não chegam mais via GetPedidosRestaurante
        // ── Utilitário: escapa caracteres HTML especiais para uso em innerHTML ──
        function escapeHtml(str) {
            if (str == null) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        const statusMap = {
            0: 'RECEBIDO',
            1: 'EM PREPARO',
            2: 'EM ENTREGA'
        };

        const statusColors = {
            0: '#fbbf24',
            1: '#f97316',
            2: '#3b82f6'
        };

        let allOrders     = [];
        let lojaAberta    = true;
        let finalizadosHoje = 0;
        let autoRefreshInterval = null;

        async function loadOrders() {
            try {
                document.getElementById('loadingContainer').style.display = 'flex';

                const response = await fetch('@Url.Action("GetPedidosRestaurante", "Restaurante")', {
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) throw new Error('Erro ao carregar pedidos');

                allOrders = await response.json();
                renderKanban();
                updateMetrics();

                document.getElementById('loadingContainer').style.display = 'none';
            } catch (error) {
                console.error('Erro:', error);
                document.getElementById('loadingContainer').innerHTML =
                    '<div style="color:#dc2626;"><i class="bi bi-exclamation-triangle" style="margin-right:8px;"></i>Erro ao carregar pedidos</div>';
            }
        }

        function renderKanban() {
            const container = document.getElementById('kanbanContainer');
            container.innerHTML = '';

            const ordersByStatus = { 0: [], 1: [], 2: [] };

            allOrders.forEach(order => {
                const status = order.status ?? 0;
                if (ordersByStatus[status] !== undefined) {
                    ordersByStatus[status].push(order);
                }
            });

            Object.keys(ordersByStatus).forEach(statusKey => {
                const status = parseInt(statusKey);
                const orders = ordersByStatus[status];

                const column = document.createElement('div');
                column.className = 'kanban-column';

                const header = document.createElement('div');
                header.className = 'column-header';
                header.innerHTML = `
                    <div class="column-title" style="color:${statusColors[status]};">
                        ${statusMap[status]}
                    </div>
                    <div class="column-count">${orders.length}</div>
                `;

                const list = document.createElement('div');
                list.className = 'orders-list';

                if (orders.length === 0) {
                    list.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                            <small>Nenhum pedido</small>
                        </div>`;
                } else {
                    orders.forEach(order => list.appendChild(createOrderCard(order, status)));
                }

                column.appendChild(header);
                column.appendChild(list);
                container.appendChild(column);
            });
        }

        function createOrderCard(order, status) {
            const card = document.createElement('div');
            card.className = 'order-card';

            const formatPrice = price =>
                new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(price || 0);

            const getTimeAgo = date => {
                const diff = Math.floor((new Date() - new Date(date)) / 1000);
                if (diff < 60) return `${diff}s`;
                if (diff < 3600) return `${Math.floor(diff / 60)}m`;
                return `${Math.floor(diff / 3600)}h`;
            };

            // Coluna 0 (RECEBIDO) e 1 (EM PREPARO): avança para a próxima
            // Coluna 2 (EM ENTREGA): finaliza gravando 'F' no banco (novoStatus: 3)
            let btnClass, btnIcon, btnLabel, btnAction;
            if (status < 2) {
                btnClass  = 'btn-advance';
                btnIcon   = 'bi-arrow-right';
                btnLabel  = `Para ${statusMap[status + 1].split(' ')[0]}`;
                btnAction = `advanceOrder(${order.id}, ${status})`;
            } else {
                btnClass  = 'btn-finalize';
                btnIcon   = 'bi-check-lg';
                btnLabel  = 'Finalizar';
                btnAction = `finalizeOrder(${order.id})`;
            }

            card.innerHTML = `
                <div class="order-header">
                    <div class="order-id">#${String(order.id).padStart(3, '0')}</div>
                    <div class="order-time">${getTimeAgo(order.data)}</div>
                </div>
                <div class="order-body">
                    <div class="order-client">${escapeHtml(order.nomeCliente || 'Cliente')}</div>
                    <div class="order-address">${escapeHtml(order.enderecoCliente || 'Endereço não informado')}</div>
                    <div class="order-price">
                        <span style="color:#888;">Valor</span>
                        <strong>${formatPrice(order.preco)}</strong>
                    </div>
                    <div class="order-actions">
                        <button class="btn-action ${btnClass}" onclick="${btnAction}">
                            <i class="bi ${btnIcon}" style="margin-right:4px;"></i>${btnLabel}
                        </button>
                        <button class="btn-action btn-view" onclick="viewOrder(${order.id})">
                            Ver Detalhes
                        </button>
                    </div>
                </div>`;

            return card;
        }

        function updateMetrics() {
            const ativos = allOrders.length;
            let tempoMedio = '--';

            if (allOrders.length > 0) {
                const tempos = allOrders
                    .filter(o => o.data)
                    .map(o => (new Date() - new Date(o.data)) / 60000)
                    .filter(t => t > 0);
                if (tempos.length > 0)
                    tempoMedio = Math.round(tempos.reduce((a, b) => a + b) / tempos.length) + 'min';
            }

            document.getElementById('metricEntregas').textContent = finalizadosHoje;
            document.getElementById('metricAtivos').textContent   = ativos;
            document.getElementById('metricTempo').textContent    = tempoMedio;
        }

        // Avança pedido para o próximo status no kanban (novoStatus 1 ou 2)
        function advanceOrder(orderId, currentStatus) {
            chamarAtualizarStatus(orderId, currentStatus + 1, () => loadOrders());
        }

        // Finaliza pedido: grava 'F' no banco (novoStatus: 3)
        // O pedido some do kanban mas permanece no banco para o cliente consultar
        function finalizeOrder(orderId) {
            if (!confirm('Confirmar finalização deste pedido?')) return;
            chamarAtualizarStatus(orderId, 3, () => {
                finalizadosHoje++;
                loadOrders();
            });
        }

        function chamarAtualizarStatus(orderId, novoStatus, onSuccess) {
            fetch('@Url.Action("AtualizarStatusPedido", "Restaurante")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ pedidoId: orderId, novoStatus: novoStatus })
            })
            .then(r => {
                if (r.ok) onSuccess();
                else alert('Erro ao atualizar pedido');
            })
            .catch(err => {
                console.error('Erro:', err);
                alert('Erro ao atualizar pedido');
            });
        }

        function viewOrder(orderId) {
            window.location.href = '@Url.Action("Details", "Pedido")?id=' + orderId;
        }

        document.getElementById('btnRefresh').addEventListener('click', loadOrders);

        document.getElementById('btnFechar').addEventListener('click', () => {
            const acao = lojaAberta ? 'fechar' : 'abrir';
            if (!confirm(`Tem certeza que deseja ${acao} a loja?`)) return;

            fetch('@Url.Action("AlternarStatusLoja", "Restaurante")', {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': document.querySelector('[name="__RequestVerificationToken"]')?.value || '' }
            })
            .then(r => {
                if (r.ok) {
                    lojaAberta = !lojaAberta;
                    document.getElementById('statusBadge').className = 'status-badge ' + (lojaAberta ? 'aberto' : 'fechado');
                    document.getElementById('statusBadge').innerHTML  = `<i class="bi bi-circle-fill" style="font-size:0.6rem;margin-right:6px;"></i>${lojaAberta ? 'Loja Aberta' : 'Loja Fechada'}`;
                    document.getElementById('btnFechar').textContent  = lojaAberta ? 'Fechar Loja' : 'Abrir Loja';
                }
            })
            .catch(err => console.error('Erro:', err));
        });

        function startAutoRefresh() {
            loadOrders();
            autoRefreshInterval = setInterval(loadOrders, 15000);
        }

        document.addEventListener('DOMContentLoaded', startAutoRefresh);
        window.addEventListener('beforeunload', () => {
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        });
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
}