@{
    ViewData["Title"] = "Gestor de Pedidos";
}

<div class="container-fluid p-0">
    <div class="row g-0">

        <main class="col-12">

            <!-- HEADER -->
            <div class="bg-white border-bottom px-5 py-4 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-4">
                    <div class="rounded-circle bg-light d-flex justify-content-center align-items-center shadow"
                         style="width:60px;height:60px;">
                        <i class="bi bi-receipt fs-3 text-dark"></i>
                    </div>
                    <div>
                        <h3 class="mb-1 fw-bold">Gestor de Pedidos</h3>
                        <span class="text-muted fs-5">Controle de pedidos em tempo real</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success px-4 py-3 fs-6">
                        Loja Aberta
                    </span>

                    <button class="btn btn-outline-dark px-4 py-2">
                        <i class="bi bi-arrow-clockwise me-2"></i> Atualizar
                    </button>

                    <button class="btn btn-outline-danger px-4 py-2">
                        Fechar Loja
                    </button>
                </div>
            </div>

            <!-- CONTEÚDO -->
            <div class="px-5 py-5">

                <!-- MÉTRICAS -->
                <div class="row g-4 mb-5">

                    <div class="col-md-4">
                        <div class="card shadow border-0 rounded-4 p-4">
                            <small class="text-muted fs-6">Entregas Hoje</small>
                            <h1 class="fw-bold mb-0 mt-2">1</h1>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow border-0 rounded-4 p-4">
                            <small class="text-muted fs-6">Pedidos Ativos</small>
                            <h1 class="fw-bold mb-0 mt-2">6</h1>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow border-0 rounded-4 p-4">
                            <small class="text-muted fs-6">Tempo Médio</small>
                            <h1 class="fw-bold mb-0 mt-2">20min</h1>
                        </div>
                    </div>

                </div>

                <!-- COLUNAS -->
                <div class="row g-5">

                    @foreach (var status in new[] { "PENDENTES", "EM PREPARO", "PRONTO", "EM ENTREGA" })
                    {
                        <div class="col-md-3">

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h4 class="fw-bold mb-0">@status</h4>
                                <span class="badge bg-light text-dark fs-6 px-3 py-2">1</span>
                            </div>

                            <div class="card shadow border-0 rounded-4 mb-4">

                                <div class="card-header bg-white border-0 d-flex justify-content-between py-3 px-4">
                                    <span class="fw-bold fs-5" style="color:#ff6600;">
                                        #007
                                    </span>
                                    <small class="text-muted fs-6">20s</small>
                                </div>

                                <div class="card-body px-4 pb-4">

                                    <p class="fw-bold fs-5 mb-1">
                                        Nome do Cliente
                                    </p>

                                    <small class="text-muted fs-6 d-block mb-4">
                                        Endereço do Cliente
                                    </small>

                                    <div class="d-flex justify-content-between align-items-center mb-4 fs-5">
                                        <span class="text-muted">Valor</span>
                                        <strong>R$ 00,00</strong>
                                    </div>

                                    <button class="btn w-100 fw-bold text-white py-3 fs-6"
                                            style="background-color:#ff6600; border:none;">
                                        Ver Pedido
                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </main>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
}