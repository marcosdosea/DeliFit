@model DeliFitWeb.Models.CartaoViewModel

@{
    ViewData["Title"] = "Detalhes do Cart�o";
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">
        <main class="col-12 p-5 bg-light">
            <div class="container">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold m-0">Detalhes do Cart�o</h2>
                        <p class="text-muted small">Visualizando informa��es do m�todo de pagamento.</p>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                            <i class="bi bi-chevron-left"></i> Voltar
                        </a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0 text-orange">
                            <i class="bi bi-credit-card-2-front me-2"></i>Dados do Cart�o
                        </h5>
                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Nome no Cart�o</label>
                                <input class="form-control border-0 bg-white p-3 fw-bold"
                                       value="@Model.Nome"
                                       disabled />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">CPF</label>
                                <input class="form-control border-0 bg-white p-3"
                                       value="@Model.Cpf"
                                       disabled />
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Bandeira / Cartão</label>
                                <input class="form-control border-0 bg-white p-3"
                                       value="@Model.Bandeira – final @Model.UltimosQuatroDigitos"
                                       disabled />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Validade</label>
                                <input class="form-control border-0 bg-white p-3"
                                       value="@Model.Validade.ToString("MM/yy")"
                                       disabled />
                            </div>
                        </div>

                        <div class="alert alert-light border small mb-0">
                            <i class="bi bi-shield-check me-1"></i>
                            Número e CVV completos não ficam salvos aqui — o cartão fica guardado com segurança no
                            cofre do Mercado Pago.
                        </div>

                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center mt-4 gap-3 pe-2">
                    <a asp-action="Index"
                       asp-route-idCliente="@Model.IdCliente"
                       class="btn btn-light px-4 border text-muted fw-bold">
                        Fechar
                    </a>
                </div>


            </div>
        </main>
    </div>
</div>

@section Scripts {

    <style>
        .text-orange {
            color: #ff6600 !important;
        }

        .form-control:disabled {
            background-color: #ffffff !important;
            opacity: 1;
            cursor: default;
            color: #212529;
            border-bottom: 1px solid #f0f0f0 !important;
        }

        .btn-orange {
            background-color: #ff6600;
            border: none;
            color: white;
            transition: all 0.2s;
        }

            .btn-orange:hover {
                background-color: #e65c00;
                transform: translateY(-1px);
            }

        .card {
            border-radius: 12px;
        }
    </style>
}
