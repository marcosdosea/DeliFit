@model DeliFitWeb.Models.CartaoViewModel

@{
    ViewData["Title"] = "Excluir Cartão";
}

<div class="container mt-5">
    <div class="container" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark">Excluir Cartão</h2>
            </div>
        </div>

        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-chevron-left"></i> Voltar
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-secondary">
                            <i class="bi bi-credit-card-2-front-fill me-2"></i>Dados do Cartão
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="small text-uppercase fw-bold text-muted">Nome no Cartão</label>
                                <p class="fs-4 fw-bold text-danger border-bottom pb-1">@Model.Nome</p>
                            </div>

                            <div class="col-md-4 text-md-end">
                                <label class="small text-uppercase fw-bold text-muted d-block">Validade</label>
                                <span class="badge bg-secondary text-white p-2 fs-6">
                                    @Model.Validade.ToString("MM/yyyy")
                                </span>

                            </div>

                            <div class="col-12 mt-2">
                                <div class="p-3 bg-light rounded border">
                                    <h6 class="small fw-bold text-uppercase text-muted mb-3">
                                        <i class="bi bi-shield-lock me-1"></i> Informações Sensíveis
                                    </h6>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <span class="d-block small text-muted text-uppercase fw-bold">Número</span>
                                            <span class="text-dark">
                                                **** **** **** @Model.Numero.Substring(Model.Numero.Length - 4)
                                            </span>
                                        </div>

                                        <div class="col-md-6">
                                            <span class="d-block small text-muted text-uppercase fw-bold">CPF</span>
                                            <span class="text-dark">@Model.Cpf</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 p-4 d-flex justify-content-end gap-2 rounded-bottom">
                        <a asp-action="Index" asp-route-idCliente="@Model.IdCliente"
                           class="btn btn-light px-4 border fw-bold text-muted">
                            Cancelar
                        </a>

                        <button type="button"
                                class="btn btn-danger shadow-sm px-4 fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#modalConfirmacaoFinal">
                            <i class="bi bi-trash3 me-2"></i>Excluir Cartão
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacaoFinal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-exclamation me-2"></i>Confirmação Final
                </h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center py-5">
                <div class="mb-3 text-danger">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                </div>

                <h5 class="fw-bold text-dark mb-3">Tem certeza absoluta?</h5>

                <p class="text-muted mb-0">
                    O cartão <strong>"@Model.Nome"</strong> será removido.<br>
                    <span class="text-danger fw-bold small">
                        ESTA OPERAÇÃO NÃO PODE SER DESFEITA.
                    </span>
                </p>
            </div>

            <div class="modal-footer justify-content-center bg-light border-0 py-3">
                <button type="button"
                        class="btn btn-outline-secondary px-4 fw-bold border-0"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IdCliente" />

                    <button type="submit"
                            class="btn btn-danger px-5 fw-bold shadow-sm">
                        Sim, Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .card {
            border-radius: 12px;
        }

        .modal-content {
            border-radius: 16px;
            overflow: hidden;
        }
    </style>
}
