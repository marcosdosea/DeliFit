@model DeliFitWeb.Models.CartaoViewModel

@{
    ViewData["Title"] = "Cadastrar Cartão";
    var idClienteContexto = Context.Request.Query["idCliente"];
    string mercadoPagoPublicKey = ViewBag.MercadoPagoPublicKey as string ?? "";
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">
        <main class="col-12 p-5 bg-light">
            <div class="container">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold m-0">Novo Cartão</h2>
                        <p class="text-muted">Cadastre um cartão para este cliente.</p>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                            <i class="bi bi-chevron-left"></i> Voltar
                        </a>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
                }

                <form asp-action="Create" id="formCartao">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small"></div>

                    <input asp-for="IdCliente" type="hidden" value="@(Model?.IdCliente ?? uint.Parse(idClienteContexto))" />
                    <input type="hidden" asp-for="Token" id="Token" />

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-0 pt-4 ps-4">
                            <h5 class="fw-bold mb-0 text-orange">
                                <i class="bi bi-credit-card me-2"></i>Dados do Cartão
                            </h5>
                            <p class="text-muted small mb-0 mt-1">
                                Número, validade e CVV são enviados direto para o Mercado Pago pelo navegador —
                                nunca passam por este servidor.
                            </p>
                        </div>

                        <div class="card-body p-4">

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Nome" class="form-label fw-semibold"></label>
                                    <input asp-for="Nome" class="form-control" placeholder="Nome impresso no cartão" />
                                    <span asp-validation-for="Nome" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Cpf" class="form-label fw-semibold"></label>
                                    <input asp-for="Cpf" class="form-control" placeholder="CPF do titular" />
                                    <span asp-validation-for="Cpf" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Número do cartão</label>
                                    <div id="form-cardNumber" class="form-control mp-secure-field"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Validade (MM/AA)</label>
                                    <div id="form-expirationDate" class="form-control mp-secure-field"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">CVV</label>
                                    <div id="form-securityCode" class="form-control mp-secure-field"></div>
                                </div>
                            </div>

                            <div id="mpStatusMsg" class="small fw-semibold mt-2"></div>

                        </div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center mt-2 mb-5 gap-2">
                        <a asp-action="Index"
                           asp-route-idCliente="@(Model?.IdCliente ?? uint.Parse(idClienteContexto))"
                           class="btn btn-light px-4 border text-muted fw-bold shadow-sm">
                            Cancelar
                        </a>

                        <button type="button" id="btnSalvarCartao" class="btn btn-orange px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-2"></i>Salvar Cartão
                        </button>
                    </div>

                </form>

            </div>
        </main>
    </div>
</div>

@section Scripts {
    <style>
        .text-orange {
            color: #ff6600 !important;
        }

        .form-label {
            font-size: 0.9rem;
            color: #495057;
        }

        .form-control, .mp-secure-field {
            border: 1px solid #dee2e6;
            padding: 0.6rem 0.75rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .mp-secure-field {
            height: calc(1.5em + 1.2rem + 2px);
        }

        .btn-orange {
            background-color: #ff6600;
            border-color: #e65c00;
            color: white;
            transition: all 0.2s;
        }

            .btn-orange:hover {
                background-color: #e65c00;
                color: white;
                transform: translateY(-1px);
            }

        .card {
            border-radius: 12px;
        }
    </style>

    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script>
        const mpPublicKey = @Html.Raw(Json.Serialize(mercadoPagoPublicKey));
        const statusEl = document.getElementById('mpStatusMsg');
        const btnSalvar = document.getElementById('btnSalvarCartao');

        function mostrarStatus(msg, cor) {
            statusEl.textContent = msg;
            statusEl.style.color = cor;
        }

        if (!mpPublicKey) {
            mostrarStatus('Mercado Pago não configurado (MercadoPago:PublicKey ausente).', '#dc2626');
            btnSalvar.disabled = true;
        } else if (typeof MercadoPago !== 'function') {
            mostrarStatus('Não foi possível carregar o SDK do Mercado Pago. Desative bloqueadores de anúncio/extensões de privacidade e recarregue a página.', '#dc2626');
            btnSalvar.disabled = true;
        } else {
            const mp = new MercadoPago(mpPublicKey);
            const fields = mp.fields;

            fields.create('cardNumber', { placeholder: 'Número do cartão' }).mount('form-cardNumber');
            fields.create('expirationDate', { placeholder: 'MM/AA' }).mount('form-expirationDate');
            fields.create('securityCode', { placeholder: 'CVV' }).mount('form-securityCode');

            btnSalvar.addEventListener('click', async function () {
                btnSalvar.disabled = true;
                mostrarStatus('Validando cartão...', '#555');

                const cardholderName = document.getElementById('Nome').value;
                const identificationNumber = document.getElementById('Cpf').value;

                try {
                    const token = await fields.createCardToken({
                        cardholderName: cardholderName,
                        identificationType: 'CPF',
                        identificationNumber: identificationNumber
                    });

                    document.getElementById('Token').value = token.id;
                    mostrarStatus('Cartão validado, salvando...', '#16a34a');
                    document.getElementById('formCartao').submit();
                } catch (err) {
                    console.error(err);
                    mostrarStatus('Não foi possível validar o cartão. Confira o número, validade e CVV.', '#dc2626');
                    btnSalvar.disabled = false;
                }
            });
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
