@model DeliFitWeb.Models.ClienteViewModel

@{
    ViewData["Title"] = "Criar Conta";
}


<div class="container mt-5" style="max-width:600px">


    <h3 class="mb-4 text-center">Criar sua conta</h3>


    <form asp-action="Create" method="post">


        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome completo</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Cpf" class="form-label">CPF</label>
            <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
            <span asp-validation-for="Cpf" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Telefone" class="form-label">Telefone</label>
            <input asp-for="Telefone" class="form-control" placeholder="(99) 99999-9999" />
            <span asp-validation-for="Telefone" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Email" class="form-label">E-mail</label>
            <input asp-for="Email" class="form-control" placeholder="email@exemplo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>


        <div class="mb-4">
            <label asp-for="DataNascimento" class="form-label">Data de nascimento</label>
            <input asp-for="DataNascimento" type="date" class="form-control" />
            <span asp-validation-for="DataNascimento" class="text-danger"></span>
        </div>


        <button type="submit" class="btn btn-primary w-100">Criar conta</button>


    </form>
</div>
