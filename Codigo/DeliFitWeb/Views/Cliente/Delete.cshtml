@model DeliFitWeb.Models.ClienteViewModel

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="bg-light min-vh-100 py-5">
    <div class="container" style="max-width: 800px;">

        <div class="mb-4">
            <a href="javascript:history.back()" class="text-decoration-none text-muted small fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4 border-start border-danger border-5">
            <div class="card-body p-4">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-danger mb-1">Zona de Perigo</h4>
                        <p class="text-muted mb-0 small">Você está prestes a excluir um cliente. Verifique os dados abaixo com atenção.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5">

                <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="bi bi-person-badge me-2 text-muted"></i>Dados da Conta
                </h5>

                <div class="row g-4">
                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Nome Completo</label>
                        <div class="bg-light p-3 rounded text-dark fw-bold border-0">
                            @Model.Nome
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">CPF</label>
                        <div class="bg-light p-3 rounded text-dark border-0">
                            @Model.Cpf
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Telefone</label>
                        <div class="bg-light p-3 rounded text-dark border-0">
                            @Model.Telefone
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">E-mail</label>
                        <div class="bg-light p-3 rounded text-dark border-0 text-truncate" title="@Model.Email">
                            @Model.Email
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning mt-4 d-flex align-items-center border-0 small" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    <div>
                        Ao excluir este cliente, <strong>todo o histórico de pedidos e endereços</strong> associados a ele será permanentemente removido.
                    </div>
                </div>

            </div>

            <div class="card-footer bg-white border-top-0 p-4 d-flex justify-content-end gap-2 rounded-bottom">
                <a asp-action="Index" class="btn btn-light px-4 border fw-bold text-muted">
                    Cancelar
                </a>
                <button type="button" class="btn btn-danger px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalConfirmacaoFinal">
                    <i class="bi bi-trash3 me-2"></i>Excluir Cliente
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacaoFinal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-exclamation me-2"></i>Confirmação Final
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center py-5">
                <div class="mb-3 text-danger">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="fw-bold text-dark mb-3">Tem certeza absoluta?</h5>
                <p class="text-muted mb-0">
                    O cliente <strong>"@Model.Nome"</strong> será apagado do sistema.<br>
                    Esta ação não poderá ser desfeita.
                </p>
            </div>

            <div class="modal-footer justify-content-center bg-light border-0 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 fw-bold border-0" data-bs-dismiss="modal">Cancelar</button>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-5 fw-bold shadow-sm">
                        Sim, Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .bg-danger-subtle {
            background-color: #fdf2f2 !important;
        }

        .card {
            border-radius: 12px;
        }

        .modal-content {
            border-radius: 16px;
            overflow: hidden;
        }
    </style>
}