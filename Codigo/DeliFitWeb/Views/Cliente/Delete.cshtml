@model DeliFitWeb.Models.ClienteViewModel


@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h2 class="fw-bold text-danger">DELIFIT</h2>
        <h4 class="text-muted">| Excluir Cliente |</h4>
    </div>

    <div class="alert alert-danger shadow-sm d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-2 me-3"></i>
        <div>
            <h4 class="alert-heading fw-bold mb-1">Atenção! Zona de Perigo.</h4>
            <p class="mb-0">
                Você está na área de exclusão. Confira os dados abaixo com cuidado antes de prosseguir.
            </p>
        </div>
    </div>

    <div class="card border-danger shadow-sm mb-4">
        <div class="card-header bg-danger text-white fw-bold">
            Revisão dos Dados
        </div>

        <div class="card-body">
            <h5 class="mb-3 text-decoration-underline text-secondary">Dados da Conta</h5>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold text-muted small">Nome</label>
                    <p class="form-control-plaintext fw-bold">@Model.Nome</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">CPF</label>
                    <p class="form-control-plaintext">@Model.Cpf</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold text-muted small">Telefone</label>
                    <p class="form-control-plaintext">@Model.Telefone</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <label class="fw-bold text-muted small">E-mail</label>
                    <p class="form-control-plaintext">@Model.Email</p>
                </div>
            </div>

            <hr class="text-muted" />

            

        <div class="card-footer bg-white d-flex justify-content-end align-items-center gap-3 py-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>

            <button type="button" class="btn btn-danger px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#modalConfirmacaoFinal">
                <i class="bi bi-trash"></i> Excluir Cliente
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacaoFinal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalLabel">
                    <i class="bi bi-shield-exclamation"></i> Confirmação de Segurança
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center py-4">
                <p class="fs-5 text-dark">Tem certeza absoluta que deseja apagar o cliente<br><strong>"@Model.Nome"</strong>?</p>
                <p class="text-danger small fw-bold mb-0">
                    <i class="bi bi-x-circle"></i> Esta ação é irreversível e apagará o histórico.
                </p>
            </div>

            <div class="modal-footer justify-content-center bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Não, voltar</button>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">
                        Sim, excluir definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
