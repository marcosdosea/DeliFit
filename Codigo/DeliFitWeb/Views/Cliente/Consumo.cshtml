@using Core
@model IEnumerable<Item>

@{
    ViewData["Title"] = "Consumo Calórico";
    DateTime dataSelecionada = ViewBag.DataSelecionada ?? DateTime.Today;
    List<DateTime> datasComPedidos = ViewBag.DatasComPedidos ?? new List<DateTime>();
    double totalKcal = ViewBag.TotalKcal ?? 0.0;
    double totalProteina = ViewBag.TotalProteina ?? 0.0;
    double totalCarboidratos = ViewBag.TotalCarboidratos ?? 0.0;
    double totalGordura = ViewBag.TotalGordura ?? 0.0;

    int idxAtual = datasComPedidos.IndexOf(dataSelecionada);
    DateTime? dataAnterior = idxAtual < datasComPedidos.Count - 1 ? datasComPedidos[idxAtual + 1] : (DateTime?)null;
    DateTime? dataProxima  = idxAtual > 0 ? datasComPedidos[idxAtual - 1] : (DateTime?)null;

    bool temItens = Model != null && Model.Any();
}

<style>
    .consumo-header {
        background: white;
        border-bottom: 1px solid #f0f0f0;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 0;
    }

    .consumo-header h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .day-nav {
        background: white;
        border-bottom: 1px solid #f0f0f0;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
    }

    .day-nav-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid #e0e0e0;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 1rem;
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s;
    }

    .day-nav-btn:hover { border-color: #ff6600; color: #ff6600; }
    .day-nav-btn.disabled { opacity: 0.3; pointer-events: none; }

    .day-label {
        text-align: center;
        min-width: 140px;
    }

    .day-label strong {
        display: block;
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .day-label small {
        font-size: 0.75rem;
        color: #888;
        text-transform: capitalize;
    }

    .day-picker-link {
        font-size: 0.78rem;
        color: #ff6600;
        text-decoration: none;
        margin-top: 2px;
        display: inline-block;
    }

    .content-area { padding: 16px 16px 90px; }

    .item-card {
        background: white;
        border-radius: 12px;
        padding: 14px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
    }

    .item-thumb {
        width: 68px;
        height: 68px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        background: #f5f5f5;
    }

    .item-thumb-placeholder {
        width: 68px;
        height: 68px;
        border-radius: 10px;
        background: #f5f5f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .item-info { flex: 1; min-width: 0; }

    .item-nome {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1a1a1a;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nutrientes {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 4px 12px;
    }

    .nutriente-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: #555;
    }

    .nutriente-item span:first-child { color: #888; }
    .nutriente-item span:last-child { font-weight: 600; color: #333; }

    .kcal-badge {
        background: #fff3e6;
        color: #ff6600;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 3px 8px;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
        align-self: flex-start;
    }

    .totals-card {
        background: white;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        border: 1px solid #f0f0f0;
        margin-top: 4px;
    }

    .totals-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1a1a1a;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .totals-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .total-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .total-item label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .total-item span {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .total-item span.kcal { color: #ff6600; }

    .empty-state {
        text-align: center;
        padding: 48px 16px;
        color: #aaa;
    }

    .empty-state i { font-size: 2.5rem; margin-bottom: 12px; display: block; }

    /* Date picker modal */
    .date-select {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 260px;
        overflow-y: auto;
        padding: 4px 0;
    }

    .date-option {
        padding: 6px 14px;
        border-radius: 20px;
        border: 1.5px solid #e0e0e0;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        color: #333;
    }

    .date-option:hover, .date-option.selected {
        border-color: #ff6600;
        background: #ff6600;
        color: white;
        text-decoration: none;
    }
</style>

<div class="consumo-header">
    <a asp-controller="Cliente" asp-action="HomeCliente" style="color:#555; font-size:1.1rem;">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2>Consumo Calórico</h2>
</div>

<div class="day-nav">
    @if (dataAnterior.HasValue)
    {
        <a class="day-nav-btn" asp-controller="Cliente" asp-action="Consumo"
           asp-route-data="@dataAnterior.Value.ToString("yyyy-MM-dd")">
            <i class="bi bi-chevron-left"></i>
        </a>
    }
    else
    {
        <span class="day-nav-btn disabled"><i class="bi bi-chevron-left"></i></span>
    }

    <div class="day-label">
        <strong>@dataSelecionada.ToString("dd/MM/yyyy")</strong>
        <small>@dataSelecionada.ToString("dddd", new System.Globalization.CultureInfo("pt-BR"))</small>
        @if (datasComPedidos.Count > 1)
        {
            <br />
            <a class="day-picker-link" href="#" data-bs-toggle="modal" data-bs-target="#modalDatas">
                <i class="bi bi-calendar3"></i> escolher data
            </a>
        }
    </div>

    @if (dataProxima.HasValue)
    {
        <a class="day-nav-btn" asp-controller="Cliente" asp-action="Consumo"
           asp-route-data="@dataProxima.Value.ToString("yyyy-MM-dd")">
            <i class="bi bi-chevron-right"></i>
        </a>
    }
    else
    {
        <span class="day-nav-btn disabled"><i class="bi bi-chevron-right"></i></span>
    }
</div>

<div class="content-area">

    @if (!temItens)
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>Nenhum item consumido neste dia.</p>
            <small>Apenas pedidos finalizados aparecem aqui.</small>
        </div>
    }
    else
    {
        @foreach (var item in Model!)
        {
            <div class="item-card">
                @if (item.Foto != null && item.Foto.Length > 0)
                {
                    <img class="item-thumb" src="@Url.Action("Foto", "Item", new { id = item.Id })" alt="@item.Nome" />
                }
                else
                {
                    <div class="item-thumb-placeholder"><i class="bi bi-image"></i></div>
                }

                <div class="item-info">
                    <div class="item-nome">@item.Nome</div>
                    <div class="nutrientes">
                        @if (item.Proteina.HasValue)
                        {
                            <div class="nutriente-item">
                                <span>Proteína</span>
                                <span>@item.Proteina.Value.ToString("0.#") g</span>
                            </div>
                        }
                        @if (item.Carboidratos.HasValue)
                        {
                            <div class="nutriente-item">
                                <span>Carboidratos</span>
                                <span>@item.Carboidratos.Value.ToString("0.#") g</span>
                            </div>
                        }
                        @if (item.Gordura.HasValue)
                        {
                            <div class="nutriente-item">
                                <span>Gordura</span>
                                <span>@item.Gordura.Value.ToString("0.#") g</span>
                            </div>
                        }
                    </div>
                </div>

                <span class="kcal-badge">@item.Calorias.ToString("0") kcal</span>
            </div>
        }

        <div class="totals-card">
            <div class="totals-title">
                <i class="bi bi-bar-chart-fill" style="color:#ff6600;"></i>
                Total Consumido
            </div>
            <div class="totals-grid">
                <div class="total-item">
                    <label>Kcal</label>
                    <span class="kcal">@totalKcal.ToString("0")</span>
                </div>
                <div class="total-item">
                    <label>Proteína</label>
                    <span>@totalProteina.ToString("0.#") g</span>
                </div>
                <div class="total-item">
                    <label>Carboidratos</label>
                    <span>@totalCarboidratos.ToString("0.#") g</span>
                </div>
                <div class="total-item">
                    <label>Gordura</label>
                    <span>@totalGordura.ToString("0.#") g</span>
                </div>
            </div>
        </div>
    }
</div>

@if (datasComPedidos.Count > 1)
{
    <div class="modal fade" id="modalDatas" tabindex="-1" aria-labelledby="modalDatasLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="modalDatasLabel">Escolher Data</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="date-select">
                        @foreach (var d in datasComPedidos)
                        {
                            <a class="date-option @(d == dataSelecionada ? "selected" : "")"
                               asp-controller="Cliente" asp-action="Consumo"
                               asp-route-data="@d.ToString("yyyy-MM-dd")">
                                @d.ToString("dd/MM/yyyy")
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
