@model DeliFitWeb.Models.ClienteModel

@{
    ViewData["Title"] = "Editar Dados Pessoais";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <!-- Voltar -->
            <a asp-action="Index" class="btn btn-link px-0 mb-3">
                ← Voltar
            </a>

            <!-- Card principal -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="card-title mb-4">Dados Pessoais</h4>

                    <form asp-action="Edit" method="post" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DataNascimento" />

                        <div class="row g-3">

                            <!-- Nome -->
                            <div class="col-12">
                                <label asp-for="Nome" class="form-label"></label>
                                <input asp-for="Nome"
                                       class="form-control"
                                       autocomplete="name"
                                       placeholder="Nome completo" />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>

                            <!-- CPF -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Cpf" class="form-label"></label>
                                <input asp-for="Cpf"
                                       class="form-control"
                                       placeholder="000.000.000-00" />
                                <span asp-validation-for="Cpf" class="text-danger"></span>
                            </div>

                            <!-- Telefone -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Telefone" class="form-label"></label>
                                <input asp-for="Telefone"
                                       class="form-control"
                                       inputmode="tel"
                                       autocomplete="tel"
                                       placeholder="(99) 99999-9999" />
                                <span asp-validation-for="Telefone" class="text-danger"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-12">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       autocomplete="email"
                                       placeholder="email@exemplo.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- Ações -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">
                            <button type="submit" class="btn btn-success px-4">
                                Salvar alterações
                            </button>

                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-danger">
                                Excluir conta
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
