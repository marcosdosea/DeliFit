@model DeliFitWeb.Models.ClienteViewModel

<style>
    .center-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
</style>

<div class="container mt-4">


    <div class="d-flex align-items-center mb-4">
        <img src="https://via.placeholder.com/100" class="rounded-circle me-3" />
        <div class="center-info">
            <h4 class="mb-0">@Model.Nome</h4>
            <small class="text-muted">@Model.Telefone</small>
        </div>
    </div>


    <div class="row g-4">
        <div class="col-md-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="text-decoration-none">
                <div class="card text-center p-4 h-100">
                    <h5>Dados Pessoais</h5>
                    <p class="text-muted">Nome, CPF, telefone e e-mail</p>
                </div>
            </a>
        </div>


        <div class="col-md-4">
            <div class="card text-center p-4 h-100">
                <h5>Endereços</h5>
                <a asp-controller="Endereco" asp-action="Index" asp-route-idCliente="@Model.Id">
                    <p class="text-muted">Gerencie seus endereços</p>
                </a>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card text-center p-4 h-100">
                <h5>Formas de Pagamento</h5>
                <p class="text-muted">Cartões e métodos salvos</p>
            </div>
        </div>
    </div>


    <div class="text-center mt-5">
        <a asp-action="Delete" asp-route-id="@Model.Id" class="text-danger">Excluir minha conta</a>
    </div>


</div>