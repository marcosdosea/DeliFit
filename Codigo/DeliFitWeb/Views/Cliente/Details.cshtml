@model DeliFitWeb.Models.ClienteViewModel

@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="bg-light min-vh-100 py-5">

    <div class="container" style="max-width: 900px;">

        <div class="mb-4">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-4">
                <div class="d-flex align-items-center">
                    <div class="position-relative">
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-secondary fw-bold fs-3 shadow-sm" style="width: 100px; height: 100px;">
                            @if (!string.IsNullOrEmpty(Model.Nome))
                            {
                                @Model.Nome.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <i class="bi bi-person"></i>
                            }
                        </div>
                        <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2" title="Ativo"></span>
                    </div>
                    <div class="ms-4">
                        <h3 class="fw-bold text-dark mb-0">@Model.Nome</h3>
                        <p class="text-muted mb-0"><i class="bi bi-phone me-1"></i> @Model.Telefone</p>
                        <span class="badge bg-orange-subtle text-orange mt-2 px-3">Cliente VIP</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="text-decoration-none card-link-hover">
                    <div class="card text-center p-4 h-100 border-0 shadow-sm card-hover-effect">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center">
                            <div class="icon-circle mb-3 bg-orange-subtle">
                                <i class="bi bi-person-lines-fill text-orange fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Dados Pessoais</h5>
                            <p class="text-muted small mb-0">Nome, CPF, e-mail e telefone</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Endereco" asp-action="Index" asp-route-idCliente="@Model.Id" class="text-decoration-none card-link-hover">
                    <div class="card text-center p-4 h-100 border-0 shadow-sm card-hover-effect">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center">
                            <div class="icon-circle mb-3 bg-orange-subtle">
                                <i class="bi bi-geo-alt-fill text-orange fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Endereços</h5>
                            <p class="text-muted small mb-0">Gerencie seus locais de entrega</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Cartao"
                   asp-action="Index"
                   asp-route-idCliente="@Model.Id"
                   class="text-decoration-none card-link-hover">
                    <div class="card text-center p-4 h-100 border-0 shadow-sm card-hover-effect">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center">
                            <div class="icon-circle mb-3 bg-orange-subtle">
                                <i class="bi bi-credit-card-2-front-fill text-orange fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Pagamentos</h5>
                            <p class="text-muted small mb-0">Cartões e métodos salvos</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>

        <div class="text-center mt-5 pt-4 border-top">
            <p class="text-muted small mb-2">Deseja encerrar seu vínculo conosco?</p>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm px-4 fw-bold">
                <i class="bi bi-trash3 me-2"></i>Excluir minha conta
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        /* Cores Institucionais */
        .text-orange {
            color: #ff6600 !important;
        }

        .bg-orange-subtle {
            background-color: #fff3e6;
        }

        /* Estilo do Círculo de Ícones */
        .icon-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        /* Efeito de Hover nos Cards */
        .card-hover-effect {
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card-link-hover:hover .card-hover-effect {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            border-bottom: 3px solid #ff6600 !important;
        }

        .card-link-hover:hover .icon-circle {
            background-color: #ff6600;
        }

            .card-link-hover:hover .icon-circle i {
                color: white !important;
            }
    </style>
}