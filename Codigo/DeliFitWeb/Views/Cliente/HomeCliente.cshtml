@model IEnumerable<DeliFitWeb.Models.RestauranteViewModel>

@{
    ViewData["Title"] = "DeliFit - Início";
}

<style>
    body {
        background-color: #f8f9fa;
        padding-bottom: 90px;
    }

    /* ── Header ── */
    .top-header {
        background: white;
        padding: 14px 16px 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid #f0f0f0;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .search-box {
        flex: 1;
        position: relative;
    }

        .search-box input {
            width: 100%;
            padding: 11px 16px 11px 42px;
            border: 1.5px solid #e8e8e8;
            border-radius: 50px;
            font-size: 0.92rem;
            background: #f8f9fa;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .search-box input:focus {
                border-color: #ff6600;
                box-shadow: 0 0 0 3px rgba(255,102,0,0.1);
                background: white;
            }

        .search-box .si {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 0.95rem;
        }

    .cart-btn {
        background: #ff6600;
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1.15rem;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(255,102,0,0.35);
        transition: transform 0.15s, box-shadow 0.15s;
    }

        .cart-btn:hover {
            transform: scale(1.05);
            color: white;
        }

    /* ── Greeting ── */
    .greeting-bar {
        padding: 14px 16px 0;
    }

        .greeting-bar h5 {
            font-weight: 700;
            color: #1a1a1a;
            font-size: 1rem;
            margin: 0;
        }

        .greeting-bar p {
            color: #888;
            font-size: 0.82rem;
            margin: 2px 0 0;
        }

    /* ── Banner ── */
    .hero-banner {
        margin: 14px 16px;
        background: linear-gradient(135deg, #ff6600 0%, #ff9933 100%);
        border-radius: 18px;
        padding: 22px 20px;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .hero-banner h2 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0 0 4px;
        }

        .hero-banner p {
            font-size: 0.85rem;
            margin: 0;
            opacity: 0.9;
        }

    /* ── Section title ── */
    .section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 20px 16px 12px;
    }

    /* ── Categories ── */
    .categories-scroll {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 0 16px 4px;
        scrollbar-width: none;
    }

        .categories-scroll::-webkit-scrollbar {
            display: none;
        }

    .cat-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        cursor: pointer;
        text-decoration: none;
        color: #444;
        transition: transform 0.2s;
    }

        .cat-chip:hover {
            transform: translateY(-2px);
        }

    .cat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        transition: box-shadow 0.2s, background 0.2s;
    }

    .cat-chip.active .cat-icon,
    .cat-chip:hover .cat-icon {
        background: #fff3e6;
        box-shadow: 0 4px 16px rgba(255,102,0,0.25);
    }

    .cat-chip span {
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ── Restaurant Cards ── */
    #restaurantList, #filteredList {
        padding: 0 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .rest-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(0,0,0,0.08);
        text-decoration: none;
        color: inherit;
        display: block;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .rest-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.13);
            color: inherit;
            text-decoration: none;
        }

    .rest-img {
        width: 100%;
        height: 170px;
        background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .rest-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .rest-img .fallback-icon {
            font-size: 3.5rem;
            color: #ccc;
        }

    .rest-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

        .rest-badge.open {
            background: #22c55e;
            color: white;
        }

        .rest-badge.close {
            background: #ef4444;
            color: white;
        }

    .rest-info {
        padding: 14px 16px 16px;
    }

    .rest-name {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 4px;
    }

    .rest-desc {
        font-size: 0.82rem;
        color: #888;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rest-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.82rem;
    }

    .rest-rating {
        color: #ff6600;
        font-weight: 600;
    }

    .rest-location {
        color: #aaa;
    }

    /* ── Empty ── */
    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #aaa;
    }

        .empty-state i {
            font-size: 3rem;
            display: block;
            margin-bottom: 12px;
        }
</style>

<div class="top-header">
    <div class="search-box">
        <i class="bi bi-search si"></i>
        <input type="text" id="searchInput" placeholder="Buscar restaurantes..." />
    </div>
    <a asp-controller="Carrinho" asp-action="Index" class="cart-btn">
        <i class="bi bi-cart3"></i>
    </a>
</div>

<div class="greeting-bar">
    @if (ViewBag.NomeCliente != null)
    {
        <h5>Olá, @ViewBag.NomeCliente! 👋</h5>
        <p>O que você vai pedir hoje?</p>
    }
    else
    {
        <h5>Olá! 👋</h5>
        <p>O que você vai pedir hoje?</p>
    }
</div>

<div class="hero-banner">
    <h2>DeliFit</h2>
    <p>Alimentação saudável com controle de macros e calorias</p>
</div>

<p class="section-title">Categorias</p>
<div class="categories-scroll">
    <a href="#" class="cat-chip active" data-category="">
        <div class="cat-icon"><i class="bi bi-grid-3x3-gap" style="color:#ff6600;"></i></div>
        <span>Ver tudo</span>
    </a>
    <a href="#" class="cat-chip" data-category="Vegetariano">
        <div class="cat-icon"><i class="bi bi-flower3" style="color:#22c55e;"></i></div>
        <span>Vegetariano</span>
    </a>
    <a href="#" class="cat-chip" data-category="Vegano">
        <div class="cat-icon"><i class="bi bi-apple" style="color:#16a34a;"></i></div>
        <span>Vegano</span>
    </a>
    <a href="#" class="cat-chip" data-category="Sem Glúten">
        <div class="cat-icon"><i class="bi bi-egg-fried" style="color:#f59e0b;"></i></div>
        <span>Sem Glúten</span>
    </a>
    <a href="#" class="cat-chip" data-category="Sem Lactose">
        <div class="cat-icon"><i class="bi bi-cup-straw" style="color:#3b82f6;"></i></div>
        <span>Sem Lactose</span>
    </a>
    <a href="#" class="cat-chip" data-category="">
        <div class="cat-icon"><i class="bi bi-basket" style="color:#ff6600;"></i></div>
        <span>Lanches</span>
    </a>
</div>

<p class="section-title">Restaurantes Disponíveis</p>

<div id="restaurantList">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-shop"></i>
            <p>Nenhum restaurante disponível no momento</p>
        </div>
    }
    else
    {
        foreach (var r in Model)
        {
            <a asp-controller="Restaurante" asp-action="VerEstabelecimento" asp-route-id="@r.Id" class="rest-card">
                <div class="rest-img">
                    <img src="@Url.Action("Foto", "Restaurante", new { id = r.Id })"
                         alt="@r.NomeRestaurante"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="fallback-icon" style="display:none; width:100%; height:100%; align-items:center; justify-content:center;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <span class="rest-badge @(r.Validado ? "open" : "close")">
                        @(r.Validado ? "ABERTO" : "FECHADO")
                    </span>
                </div>
                <div class="rest-info">
                    <p class="rest-name">@r.NomeRestaurante</p>
                    <p class="rest-desc">@(r.Descricao ?? "Restaurante especializado em comida saudável")</p>
                    <div class="rest-meta">
                        <span class="rest-rating"><i class="bi bi-star-fill me-1"></i>4.5</span>
                        <span class="rest-location"><i class="bi bi-geo-alt me-1"></i>@r.Cidade</span>
                    </div>
                </div>
            </a>
        }
    }
</div>

<div id="filteredList" style="display:none;"></div>

@section Scripts {
    <script>
        const restaurantes = @Html.Raw(Json.Serialize(
                    (Model ?? Enumerable.Empty<DeliFitWeb.Models.RestauranteViewModel>())
                    .Select(r => new
                    {
                            id = r.Id,
                            nome = r.NomeRestaurante,
                            descricao = r.Descricao ?? "Restaurante especializado em comida saudável",
                            cidade = r.Cidade,
                            validado = r.Validado
                    }).ToList()
            ));

        const listOriginal = document.getElementById('restaurantList');
        const listFiltered = document.getElementById('filteredList');
        const search = document.getElementById('searchInput');

        function buildCard(r) {
            const badge = r.validado
                ? `<span class="rest-badge open">ABERTO</span>`
                : `<span class="rest-badge close">FECHADO</span>`;
            return `
            <a href="/Restaurante/VerEstabelecimento/${r.id}" class="rest-card">
                <div class="rest-img">
                    <img src="/Restaurante/Foto/${r.id}" alt="${r.nome}"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="fallback-icon" style="display:none; width:100%; height:100%; align-items:center; justify-content:center;">
                        <i class="bi bi-shop"></i>
                    </div>
                    ${badge}
                </div>
                <div class="rest-info">
                    <p class="rest-name">${r.nome}</p>
                    <p class="rest-desc">${r.descricao}</p>
                    <div class="rest-meta">
                        <span class="rest-rating"><i class="bi bi-star-fill me-1"></i>4.5</span>
                        <span class="rest-location"><i class="bi bi-geo-alt me-1"></i>${r.cidade || ''}</span>
                    </div>
                </div>
            </a>`;
        }

        search.addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();
            if (!q) {
                listOriginal.style.display = 'flex';
                listFiltered.style.display = 'none';
                listFiltered.innerHTML = '';
                return;
            }
            const found = restaurantes.filter(r =>
                r.nome.toLowerCase().includes(q) ||
                (r.descricao && r.descricao.toLowerCase().includes(q))
            );
            listOriginal.style.display = 'none';
            listFiltered.style.display = 'flex';
            listFiltered.innerHTML = found.length
                ? found.map(buildCard).join('')
                : `<div class="empty-state"><i class="bi bi-search"></i><p>Nenhum resultado para "${this.value}"</p></div>`;
        });

        // Category chips (visual toggle only for now)
        document.querySelectorAll('.cat-chip').forEach(chip => {
            chip.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
            });
        });
    </script>
}
