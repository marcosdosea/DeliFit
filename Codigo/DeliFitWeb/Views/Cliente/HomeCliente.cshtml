@model IEnumerable<DeliFitWeb.Models.RestauranteViewModel>

@{
    ViewData["Title"] = "DeliFit - Início";
    var itens = ViewBag.Itens as List<DeliFitWeb.Models.ItemViewModel> ?? new List<DeliFitWeb.Models.ItemViewModel>();
    var clienteId = ViewBag.ClienteId is uint cid ? cid : 0u;
    var categorias = ViewBag.Categorias as List<DeliFitWeb.Models.CategoriaViewModel> ?? new List<DeliFitWeb.Models.CategoriaViewModel>();

    string IconeCategoria(string nome) => nome?.ToLower() switch
    {
        "vegetariano" => "bi-flower3",
        "vegano" => "bi-apple",
        "sem glúten" => "bi-egg-fried",
        "sem lactose" => "bi-cup-straw",
        "fitness" => "bi-heart-pulse",
        "low carb" => "bi-lightning",
        "zero lactose" => "bi-droplet-half",
        "proteico" => "bi-trophy",
        _ => "bi-grid"
    };
}

<style>
    body {
        background: #f4f5f7;
        padding-bottom: 80px;
    }

    /* ───── HEADER ───── */
    .app-header {
        background: white;
        padding: 14px 16px 12px;
        position: sticky;
        top: 0;
        z-index: 200;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }

    .addr-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

        .addr-row a {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #1a1a1a;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
        }

            .addr-row a i.loc {
                color: #ff6600;
                font-size: 1.1rem;
            }

        .addr-row .chev {
            color: #aaa;
            font-size: 0.75rem;
        }

    .search-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-box {
        flex: 1;
        position: relative;
    }
    /* Campo de busca agora é um link para M23 */
    .search-link {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        padding: 10px 16px 10px 40px;
        border: 1.5px solid #ebebeb;
        border-radius: 50px;
        font-size: 0.88rem;
        background: #f8f9fa;
        color: #aaa;
        text-decoration: none;
        cursor: text;
        position: relative;
    }

        .search-link i.si {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #bbb;
            font-size: 0.9rem;
        }

        .search-link:hover {
            border-color: #ff6600;
            background: white;
        }

    .cart-btn {
        background: #ff6600;
        color: white;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        text-decoration: none;
        flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(255,102,0,0.35);
        transition: transform 0.15s;
        position: relative;
    }

        .cart-btn:hover {
            transform: scale(1.06);
            color: white;
        }

    .cart-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #e53e3e;
        color: white;
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
    }

    /* ───── SECTION TITLE ───── */
    .sec-title {
        font-size: 1rem;
        font-weight: 800;
        color: #1a1a1a;
        padding: 18px 16px 10px;
    }

    /* ───── CATEGORIES ───── */
    .cat-scroll {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 0 16px 6px;
        scrollbar-width: none;
    }

        .cat-scroll::-webkit-scrollbar {
            display: none;
        }

    .cat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        cursor: pointer;
        text-decoration: none;
        color: #555;
    }

    .cat-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        transition: all 0.2s;
        border: 2px solid transparent;
    }

    .cat-item.active .cat-icon,
    .cat-item:hover .cat-icon {
        border-color: #ff6600;
        background: #fff3e6;
    }

    .cat-item span {
        font-size: 0.72rem;
        font-weight: 600;
        white-space: nowrap;
        color: #444;
    }

    .cat-item.active span {
        color: #ff6600;
    }

    /* ───── RESTAURANTS horizontal scroll ───── */
    .rest-scroll {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        padding: 0 16px 6px;
        scrollbar-width: none;
    }

        .rest-scroll::-webkit-scrollbar {
            display: none;
        }

    .rest-card-h {
        flex-shrink: 0;
        width: 190px;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s, box-shadow 0.2s;
        display: block;
    }

        .rest-card-h:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0,0,0,0.13);
            color: inherit;
            text-decoration: none;
        }

    .rest-img-h {
        width: 100%;
        height: 110px;
        background: linear-gradient(135deg,#f0f0f0,#e4e4e4);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

        .rest-img-h img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .rest-fallback {
        font-size: 2.5rem;
        color: #ccc;
    }

    .rest-badge-h {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 700;
    }

        .rest-badge-h.open {
            background: #22c55e;
            color: white;
        }

        .rest-badge-h.close {
            background: #ef4444;
            color: white;
        }

    .rest-body-h {
        padding: 10px 12px 12px;
    }

    .rest-name-h {
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rest-meta-h {
        font-size: 0.72rem;
        color: #aaa;
        display: flex;
        gap: 8px;
    }

    /* ───── DISHES GRID ───── */
    .dishes-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 0 16px;
    }

    .dish-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0,0,0,0.07);
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .dish-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            color: inherit;
            text-decoration: none;
        }

    .dish-img {
        width: 100%;
        height: 100px;
        background: linear-gradient(135deg,#f5f5f5,#eaeaea);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .dish-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .dish-no-img {
        font-size: 2rem;
        color: #ddd;
    }

    .dish-body {
        padding: 9px 10px 11px;
    }

    .dish-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dish-macros {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .macro {
        font-size: 0.62rem;
        font-weight: 600;
        padding: 1px 5px;
        border-radius: 5px;
    }

        .macro.cal {
            background: #fef9c3;
            color: #854d0e;
        }

        .macro.prot {
            background: #dcfce7;
            color: #166534;
        }

    .dish-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .dish-price {
        font-size: 0.9rem;
        font-weight: 800;
        color: #ff6600;
    }

    .dish-rest {
        font-size: 0.62rem;
        color: #bbb;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 55%;
        text-align: right;
    }

    /* ───── EMPTY ───── */
    .empty-state {
        text-align: center;
        padding: 30px 20px;
        color: #bbb;
    }

        .empty-state i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 8px;
        }

    /* ───── BOTTOM NAV (M01 wireframe: Início / Pedidos / Consumo / Menu) ───── */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 1px solid #f0f0f0;
        display: flex;
        z-index: 500;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
    }

    .nav-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8px 0 10px;
        gap: 3px;
        text-decoration: none;
        color: #aaa;
        font-size: 0.65rem;
        font-weight: 600;
        transition: color 0.15s;
        position: relative;
    }

        .nav-item i {
            font-size: 1.3rem;
        }

        .nav-item.active {
            color: #ff6600;
        }

        .nav-item:hover {
            color: #ff6600;
            text-decoration: none;
        }

    .nav-badge {
        position: absolute;
        top: 6px;
        background: #e53e3e;
        color: white;
        font-size: 0.6rem;
        font-weight: 700;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        right: calc(50% - 14px);
    }
</style>

<!-- ══════════════ HEADER ══════════════ -->
<div class="app-header">
    <div class="addr-row">
        <a asp-controller="Endereco" asp-action="Index" asp-route-idCliente="@clienteId">
            <i class="bi bi-geo-alt-fill loc"></i>
            <span>Meus Endereços</span>
            <i class="bi bi-chevron-right chev"></i>
        </a>
    </div>
    <div class="search-row">
        <!-- Campo de busca leva para M23 -->
        <a asp-controller="Categoria" asp-action="Buscar" class="search-link">
            <i class="bi bi-search si"></i>
            Buscar restaurantes ou pratos...
        </a>
        <!-- Carrinho com badge -->
        <a asp-controller="Carrinho" asp-action="Index" class="cart-btn" id="cartBtnHome">
            <i class="bi bi-cart3"></i>
            <span class="cart-badge d-none" id="cartBadgeHome">0</span>
        </a>
    </div>
</div>

<!-- ══════════════ CATEGORIAS (dinâmicas do banco) ══════════════ -->
<p class="sec-title">Categorias</p>
<div class="cat-scroll">
    <a class="cat-item active" data-filter=""
       onclick="event.preventDefault(); renderRest(todosRestaurantes); renderItens(todosItens);"
       href="#">
        <div class="cat-icon"><i class="bi bi-grid-3x3-gap" style="color:#ff6600;"></i></div>
        <span>Ver tudo</span>
    </a>
    @foreach (var cat in categorias)
    {
        <a class="cat-item"
           asp-controller="Categoria" asp-action="Ver"
           asp-route-categoria="@cat.Nome">
            <div class="cat-icon">
                <i class="bi @IconeCategoria(cat.Nome)" style="color:#ff6600;"></i>
            </div>
            <span>@cat.Nome</span>
        </a>
    }
</div>

<!-- ══════════════ RESTAURANTES ══════════════ -->
<p class="sec-title">Estabelecimentos</p>
<div class="rest-scroll" id="restScroll">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state" style="width:100%;">
            <i class="bi bi-shop"></i>
            <p>Nenhum restaurante disponível</p>
        </div>
    }
    else
    {
        foreach (var r in Model)
        {
            <a asp-controller="Restaurante" asp-action="VerEstabelecimento"
               asp-route-id="@r.Id" class="rest-card-h">
                <div class="rest-img-h">
                    <img src="@Url.Action("Foto", "Restaurante", new { id = r.Id })"
                         alt="@r.NomeRestaurante"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="rest-fallback" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <span class="rest-badge-h @(r.Validado ? "open" : "close")">
                        @(r.Validado ? "ABERTO" : "FECHADO")
                    </span>
                </div>
                <div class="rest-body-h">
                    <p class="rest-name-h">@r.NomeRestaurante</p>
                    <div class="rest-meta-h">
                        <span><i class="bi bi-star-fill" style="color:#ff6600;"></i> 4.5</span>
                        <span><i class="bi bi-geo-alt"></i> @r.Cidade</span>
                    </div>
                </div>
            </a>
        }
    }
</div>

<!-- ══════════════ PRATOS ══════════════ -->
<p class="sec-title" id="pratosTitle">Pratos em Destaque</p>
<div class="dishes-grid" id="dishesGrid">
    @{
        var restDict = (Model ?? Enumerable.Empty<RestauranteViewModel>())
                        .ToDictionary(r => r.Id, r => r.NomeRestaurante);
    }
    @if (!itens.Any())
    {
        <div class="empty-state" style="grid-column:1/-1;">
            <i class="bi bi-egg-fried"></i>
            <p>Nenhum prato disponível</p>
        </div>
    }
    else
    {
        foreach (var item in itens)
        {
            var nomeRest = restDict.TryGetValue(item.IdRestaurante, out var n) ? n : "";
            <a asp-controller="Restaurante" asp-action="VerEstabelecimento"
               asp-route-id="@item.IdRestaurante"
               class="dish-card" data-restricao="@string.Join(", ", item.CategoriaNomes)">
                <div class="dish-img">
                    <img src="@Url.Action("Foto", "Item", new { id = item.Id })"
                         alt="@item.Nome"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="dish-no-img" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;">
                        <i class="bi bi-egg-fried"></i>
                    </div>
                </div>
                <div class="dish-body">
                    <p class="dish-name" title="@item.Nome">@item.Nome</p>
                    <div class="dish-macros">
                        <span class="macro cal">@item.Calorias.ToString("0") kcal</span>
                        @if (item.Proteina.HasValue)
                        {
                            <span class="macro prot">@item.Proteina.Value.ToString("0")g P</span>
                        }
                    </div>
                    <div class="dish-footer">
                        <span class="dish-price">R$ @item.Preco.ToString("N2")</span>
                        <span class="dish-rest">@nomeRest</span>
                    </div>
                </div>
            </a>
        }
    }
</div>

<!-- ══════════════ BARRA DE NAVEGAÇÃO INFERIOR (M01) ══════════════ -->
<nav class="bottom-nav">
    <a asp-controller="Cliente" asp-action="HomeCliente" class="nav-item active">
        <i class="bi bi-house-fill"></i>
        <span>Início</span>
    </a>
    <a asp-controller="Pedido" asp-action="Index" class="nav-item">
        <i class="bi bi-bag-fill"></i>
        <span>Pedidos</span>
    </a>
    <a asp-controller="Cliente" asp-action="Perfil" class="nav-item">
        <i class="bi bi-person-fill"></i>
        <span>Consumo</span>
    </a>
    <a asp-controller="Categoria" asp-action="Index" class="nav-item">
        <i class="bi bi-grid-fill"></i>
        <span>Menu</span>
    </a>
</nav>

@section Scripts {
    <script>
        // ── Badge do carrinho ──
        (function atualizarBadge() {
            fetch('/Carrinho/ContarItens')
                .then(r => r.json())
                .then(d => {
                    const headerBadge = document.getElementById('cartBadgeHome');
                    const navBadge    = null;
                    if (d.total > 0) {
                        if (headerBadge) { headerBadge.textContent = d.total; headerBadge.classList.remove('d-none'); }

                    }
                })
                .catch(() => {});
        })();

        // ── Serializa dados para filtro JS das categorias no dishesGrid ──
        const todosRestaurantes = @Html.Raw(Json.Serialize(
                    (Model ?? Enumerable.Empty<DeliFitWeb.Models.RestauranteViewModel>())
                    .Select(r => new { id = r.Id, nome = r.NomeRestaurante, cidade = r.Cidade, validado = r.Validado }).ToList()
            ));

        const todosItens = @Html.Raw(Json.Serialize(
                    itens.Select(i => new
                    {
                            id = i.Id,
                            nome = i.Nome,
                            preco = i.Preco,
                            calorias = i.Calorias,
                            proteina = i.Proteina,
                            restricao = string.Join(", ", i.CategoriaNomes),
                            idRestaurante = i.IdRestaurante
                    }).ToList()
            ));

        const rDict = {};
        todosRestaurantes.forEach(r => rDict[r.id] = r.nome);

        // ── Renders ──
        function renderRest(lista) {
            const el = document.getElementById('restScroll');
            el.innerHTML = lista.length ? lista.map(r => `
                <a href="/Restaurante/VerEstabelecimento/${r.id}" class="rest-card-h">
                    <div class="rest-img-h">
                        <img src="/Restaurante/Foto/${r.id}" alt="${r.nome}"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="rest-fallback" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;"><i class="bi bi-shop"></i></div>
                        <span class="rest-badge-h ${r.validado ? 'open' : 'close'}">${r.validado ? 'ABERTO' : 'FECHADO'}</span>
                    </div>
                    <div class="rest-body-h">
                        <p class="rest-name-h">${r.nome}</p>
                        <div class="rest-meta-h">
                            <span><i class="bi bi-star-fill" style="color:#ff6600;"></i> 4.5</span>
                            <span><i class="bi bi-geo-alt"></i> ${r.cidade || ''}</span>
                        </div>
                    </div>
                </a>`).join('')
            : `<div class="empty-state" style="width:100%;"><i class="bi bi-shop d-block mb-2" style="font-size:2rem;"></i><p>Nenhum resultado</p></div>`;
        }

        function renderItens(lista) {
            const el = document.getElementById('dishesGrid');
            el.innerHTML = lista.length ? lista.map(i => `
                <a href="/Restaurante/VerEstabelecimento/${i.idRestaurante}" class="dish-card">
                    <div class="dish-img">
                        <img src="/Item/Foto/${i.id}" alt="${i.nome}"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="dish-no-img" style="display:none;width:100%;height:100%;align-items:center;justify-content:center;"><i class="bi bi-egg-fried"></i></div>
                    </div>
                    <div class="dish-body">
                        <p class="dish-name">${i.nome}</p>
                        <div class="dish-macros">
                            <span class="macro cal">${Math.round(i.calorias)} kcal</span>
                            ${i.proteina !== null && i.proteina !== undefined ? `<span class="macro prot">${Math.round(i.proteina)}g P</span>` : ''}
                        </div>
                        <div class="dish-footer">
                            <span class="dish-price">R$ ${parseFloat(i.preco).toFixed(2).replace('.', ',')}</span>
                            <span class="dish-rest">${rDict[i.idRestaurante] || ''}</span>
                        </div>
                    </div>
                </a>`).join('')
            : `<div class="empty-state" style="grid-column:1/-1;"><i class="bi bi-egg-fried d-block mb-2" style="font-size:2rem;"></i><p>Nenhum prato encontrado</p></div>`;
        }
    </script>
}
