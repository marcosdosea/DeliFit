@model DeliFitWeb.Models.ConfigurarAtendimentoViewModel

@{
    ViewData["Title"] = "Configurar Atendimento";
}

<div class="container-fluid p-0 bg-white">
    <div class="row g-0">
        <main class="col-12 p-5 bg-light">
            <div class="container-fluid">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold m-0">Configurar Atendimento</h2>
                        <p class="text-muted small mb-0">Defina os horários de funcionamento para cada dia da semana</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-list-ul me-1"></i> Ver Listagem
                    </a>
                </div>

                <form asp-action="Configurar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdRestaurante" />

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 py-3 text-muted small fw-bold text-uppercase" style="width:40px;">Ativo</th>
                                        <th class="py-3 text-muted small fw-bold text-uppercase">Dia da Semana</th>
                                        <th class="py-3 text-muted small fw-bold text-uppercase">Abertura</th>
                                        <th class="py-3 text-muted small fw-bold text-uppercase">Fechamento</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Dias.Count; i++)
                                    {
                                        <tr class="dia-row @(Model.Dias[i].Ativo ? "row-ativo" : "row-inativo")">
                                            <td class="ps-4">
                                                <input type="hidden" name="Dias[@i].Id" value="@Model.Dias[i].Id" />
                                                <input type="hidden" name="Dias[@i].DiaSemana" value="@Model.Dias[i].DiaSemana" />
                                                <input type="hidden" name="Dias[@i].NomeDia" value="@Model.Dias[i].NomeDia" />
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input dia-toggle" type="checkbox"
                                                           name="Dias[@i].Ativo" value="true"
                                                           id="ativo_@i"
                                                           @(Model.Dias[i].Ativo ? "checked" : "") />
                                                    <input type="hidden" name="Dias[@i].Ativo" value="false" />
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm bg-orange-subtle rounded-circle me-2 d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-calendar-week text-orange small"></i>
                                                    </div>
                                                    <label for="ativo_@i" class="fw-bold text-dark mb-0" style="cursor:pointer;">
                                                        @Model.Dias[i].NomeDia
                                                    </label>
                                                </div>
                                            </td>
                                            <td>
                                                <input type="time"
                                                       name="Dias[@i].HorarioInicio"
                                                       value="@Model.Dias[i].HorarioInicio"
                                                       class="form-control form-control-sm time-input"
                                                       style="max-width:130px;"
                                                       @(Model.Dias[i].Ativo ? "" : "disabled") />
                                            </td>
                                            <td>
                                                <input type="time"
                                                       name="Dias[@i].HorarioFim"
                                                       value="@Model.Dias[i].HorarioFim"
                                                       class="form-control form-control-sm time-input"
                                                       style="max-width:130px;"
                                                       @(Model.Dias[i].Ativo ? "" : "disabled") />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-orange text-white px-5 fw-bold">
                            <i class="bi bi-save me-1"></i> Salvar Configuração
                        </button>
                    </div>
                </form>

            </div>
        </main>
    </div>
</div>

@section Scripts {
    <style>
        .text-orange { color: #ff6600 !important; }
        .bg-orange-subtle { background-color: #fff3e6; }

        .btn-orange {
            background-color: #ff6600;
            border: none;
            transition: all 0.2s;
        }
        .btn-orange:hover {
            background-color: #e65c00;
            transform: translateY(-1px);
        }

        .avatar-sm { width: 32px; height: 32px; }

        .row-inativo td { opacity: 0.45; }
        .row-inativo .form-check-input { opacity: 1 !important; }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.25em;
            cursor: pointer;
        }
        .form-check-input:checked { background-color: #ff6600; border-color: #ff6600; }

        .table tbody tr:hover { background-color: #fffaf5; }
        .table thead th { border-bottom: 2px solid #f8f9fa; }
    </style>

    <script>
        document.querySelectorAll('.dia-toggle').forEach(function (toggle) {
            toggle.addEventListener('change', function () {
                var row = this.closest('tr');
                var inputs = row.querySelectorAll('.time-input');
                if (this.checked) {
                    row.classList.remove('row-inativo');
                    row.classList.add('row-ativo');
                    inputs.forEach(function (inp) { inp.disabled = false; });
                } else {
                    row.classList.remove('row-ativo');
                    row.classList.add('row-inativo');
                    inputs.forEach(function (inp) { inp.disabled = true; });
                }
            });
        });
    </script>
}
