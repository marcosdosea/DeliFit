@{
    ViewData["Title"] = "Bem-vindo ao DeliFit";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="container text-center">

        <h1 class="display-4 fw-bold mb-3" style="color: var(--df-orange);">
            <i class="bi bi-fire"></i> Bem-vindo ao DeliFit
        </h1>

        <p class="lead mb-5" style="color: var(--df-body);">
            Alimentação saudável com controle de macros e calorias
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mx-auto" style="max-width: 600px;" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mx-auto" style="max-width: 600px;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row justify-content-center g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow-lg border-0 rounded-4">
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="card-title mb-3" style="color: var(--df-orange);">
                            <i class="bi bi-person-circle" style="font-size: 3rem;"></i>
                        </h3>
                        <h4 class="fw-bold mb-3">Sou Cliente</h4>
                        <p class="card-text text-muted mb-4">
                            Faça pedidos, acompanhe suas calorias e descubra novos restaurantes.
                        </p>
                        <div class="mt-auto d-grid gap-2">
                            <a href="/Identity/Account/Register?role=Cliente"
                               class="btn btn-outline-primary btn-lg fw-bold">
                                <i class="bi bi-person-plus"></i> Criar Conta
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-lg border-0 rounded-4">
                    <div class="card-body d-flex flex-column p-4">
                        <h3 class="card-title mb-3" style="color: var(--df-success);">
                            <i class="bi bi-shop" style="font-size: 3rem;"></i>
                        </h3>
                        <h4 class="fw-bold mb-3">Sou Restaurante</h4>
                        <p class="card-text text-muted mb-4">
                            Gerencie seu cardápio, acompanhe pedidos e faturamento.
                        </p>
                        <div class="mt-auto d-grid gap-2">
                            <a href="/Restaurante/SolicitarAdesao"
                               class="btn btn-outline-success btn-lg fw-bold">
                                <i class="bi bi-clipboard-check"></i> Solicitar Adesão
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Botão de Login Unificado -->
        <div class="mt-5">
            <a href="/Identity/Account/Login"
               class="btn btn-primary btn-lg px-5 py-3 fw-bold rounded-pill shadow"
               style="font-size: 1.2rem;">
                <i class="bi bi-box-arrow-in-right"></i> Entrar no Sistema
            </a>
            <p class="mt-3 small" style="color: var(--df-muted);">
                Acesso unificado para clientes, restaurantes e administradores
            </p>
        </div>

    </div>
</div>