@model DeliFitWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Editar Restaurante";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Editar Cadastro</h2>
            <p class="text-muted">Atualize as informações do estabelecimento.</p>
        </div>
        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-chevron-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0" role="alert"></div>

        <input type="hidden" asp-for="Id" />
        @* Preserva o status de validação ao editar — sem isso o restaurante volta para pendente *@
        <input type="hidden" asp-for="Validado" />

        <div class="row">

            <div class="col-lg-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0 text-orange"><i class="bi bi-image me-2"></i>Foto do Restaurante</h5>
                    </div>
                    <div class="card-body p-4">

                        @if (Model.Foto != null && Model.Foto.Length > 0)
                        {
                            <div class="mb-3 text-center">
                                <p class="small fw-bold text-muted text-uppercase mb-2">Foto Atual</p>
                                <img src="@Url.Action("Foto", "Restaurante", new { id = Model.Id })"
                                     alt="Foto do restaurante"
                                     class="rounded"
                                     style="max-height: 200px; max-width: 100%; object-fit: contain; border: 2px solid #ff6600;" />
                            </div>
                        }

                        <div class="mb-2">
                            <label asp-for="FotoFile" class="form-label fw-semibold">
                                @(Model.Foto != null && Model.Foto.Length > 0 ? "Substituir Foto" : "Adicionar Foto")
                                <span class="fw-normal text-muted small">(opcional &middot; JPEG ou PNG &middot; máx. 2 MB)</span>
                            </label>
                            <input asp-for="FotoFile"
                                   type="file"
                                   accept="image/jpeg,image/png"
                                   class="form-control"
                                   onchange="previewFoto(this)" />
                            <span asp-validation-for="FotoFile" class="text-danger small"></span>

                            @if (Model.Foto != null && Model.Foto.Length > 0)
                            {
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-info-circle me-1"></i>Deixe em branco para manter a foto atual.
                                </small>
                            }
                        </div>

                        <div id="previewContainer" class="d-none text-center mt-3">
                            <p class="small fw-bold text-muted text-uppercase mb-2">Nova Foto</p>
                            <img id="fotoPreview"
                                 src="#"
                                 alt="Pré-visualização"
                                 class="rounded"
                                 style="max-height: 200px; max-width: 100%; object-fit: contain; border: 2px dashed #ff6600;" />
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0 text-orange"><i class="bi bi-person-badge me-2"></i>Dados do Proprietário</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NomeProprietario" class="form-label fw-semibold"></label>
                                <input asp-for="NomeProprietario" class="form-control" />
                                <span asp-validation-for="NomeProprietario" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="CpfProprietario" class="form-label fw-semibold"></label>
                                <input asp-for="CpfProprietario" class="form-control" />
                                <span asp-validation-for="CpfProprietario" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="TelefoneProprietario" class="form-label fw-semibold"></label>
                                <input asp-for="TelefoneProprietario" class="form-control" />
                                <span asp-validation-for="TelefoneProprietario" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 ps-4">
                        <h5 class="fw-bold mb-0 text-orange"><i class="bi bi-shop me-2"></i>Dados do Restaurante</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NomeRestaurante" class="form-label fw-semibold"></label>
                                <input asp-for="NomeRestaurante" class="form-control" />
                                <span asp-validation-for="NomeRestaurante" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Cnpj" class="form-label fw-semibold"></label>
                                <input asp-for="Cnpj" class="form-control" />
                                <span asp-validation-for="Cnpj" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="TelefoneRestaurante" class="form-label fw-semibold"></label>
                                <input asp-for="TelefoneRestaurante" class="form-control" />
                                <span asp-validation-for="TelefoneRestaurante" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25">

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Cep" class="form-label fw-semibold"></label>
                                <input asp-for="Cep" class="form-control" />
                                <span asp-validation-for="Cep" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Rua" class="form-label fw-semibold"></label>
                                <input asp-for="Rua" class="form-control" />
                                <span asp-validation-for="Rua" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Numero" class="form-label fw-semibold"></label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Cidade" class="form-label fw-semibold"></label>
                                <input asp-for="Cidade" class="form-control" />
                                <span asp-validation-for="Cidade" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Bairro" class="form-label fw-semibold"></label>
                                <input asp-for="Bairro" class="form-control" />
                                <span asp-validation-for="Bairro" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Estado" class="form-label fw-semibold"></label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="">Selecione...</option>
                                    <option value="SP">São Paulo</option>
                                    <option value="RJ">Rio de Janeiro</option>
                                    <option value="MG">Minas Gerais</option>
                                    <option value="SE">Sergipe</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end align-items-center mt-2 mb-5 gap-3">
            <a asp-action="Index" class="text-decoration-none text-secondary fw-bold">Cancelar Alterações</a>
            <button type="submit" class="btn btn-orange btn-lg px-5 py-2 shadow-sm">
                <i class="bi bi-save me-2"></i>Salvar Alterações
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        .text-orange {
            color: #ff6600 !important;
        }

        .form-label {
            font-size: 0.9rem;
            color: #495057;
        }

        .form-control:focus, .form-select:focus {
            border-color: #ff6600;
            box-shadow: 0 0 0 0.25rem rgba(255, 102, 0, 0.15);
        }

        .btn-orange {
            background-color: #ff6600;
            border-color: #e65c00;
            color: white;
            font-weight: 600;
        }

            .btn-orange:hover {
                background-color: #e65c00;
                color: white;
            }

        .card {
            border-radius: 12px;
        }
    </style>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewFoto(input) {
            const container = document.getElementById('previewContainer');
            const preview = document.getElementById('fotoPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                container.classList.add('d-none');
                preview.src = '#';
            }
        }
    </script>
}
