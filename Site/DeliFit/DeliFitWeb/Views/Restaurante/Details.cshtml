@model DeliFitWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Perfil do Restaurante";
}

<div class="container-fluid p-0">
    <div class="row g-0">

        <main class="col-md-10">

            <div class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle border d-flex justify-content-center align-items-center overflow-hidden"
                         style="width:35px; height:35px;">
                        @if (Model.Foto != null && Model.Foto.Length > 0)
                        {
                            <img src="@Url.Action("Foto", "Restaurante", new { id = Model.Id })"
                                 alt="@Model.NomeRestaurante"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <span class="fw-bold small">R</span>
                        }
                    </div>
                    <span class="fw-bold">@Model.NomeRestaurante</span>
                </div>
            </div>

            <div class="position-relative">
                <div class="w-100 bg-light d-flex justify-content-center align-items-center overflow-hidden"
                     style="height: 180px; background: linear-gradient(to bottom, #f8f9fa, #e9ecef);">
                    <i class="bi bi-mountains display-1 text-secondary opacity-25"></i>
                </div>

                <div class="position-absolute translate-middle-y start-0 ms-5 shadow-sm rounded-circle bg-white border d-flex justify-content-center align-items-center overflow-hidden"
                     style="width: 120px; height: 120px; bottom: -40px;">
                    @if (Model.Foto != null && Model.Foto.Length > 0)
                    {
                        <img src="@Url.Action("Foto", "Restaurante", new { id = Model.Id })"
                             alt="Foto de @Model.NomeRestaurante"
                             style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="display-4 fw-bold" style="color: #ff9800;">R</span>
                    }
                </div>
            </div>

            <div class="px-5 pt-5 mt-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="flex-grow-1 row g-3">
                        <div class="col-md-5">
                            <label class="small fw-bold text-muted">Nome restaurante</label>
                            <input class="form-control bg-white" value="@Model.NomeRestaurante" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold text-muted">Telefone</label>
                            <input class="form-control bg-white" value="@Model.TelefoneRestaurante" disabled />
                        </div>
                        <div class="col-md-1 text-end pt-4">
                            <span class="fw-bold fs-5">4,4 <i class="bi bi-star text-warning"></i></span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-10">
                        <label class="small fw-bold text-muted">Endereço</label>
                        <input class="form-control bg-white"
                               value="@Model.Rua, @Model.Numero, @Model.Bairro, @Model.Cidade - @Model.Estado"
                               disabled />
                    </div>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-md-10">
                        <label class="small fw-bold text-muted">Descrição</label>
                        <textarea class="form-control bg-white" rows="4" disabled>@Model.Descricao</textarea>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="small fw-bold text-muted">Status</label>
                        <input class="form-control bg-white" value="@(Model.Validado ? "Ativo" : "Inativo")" disabled />
                    </div>
                </div>

                <div class="text-end pe-5 pb-5">
                    <a asp-controller="Restaurante"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn px-5 fw-bold text-white shadow-sm text-decoration-none"
                       style="background-color: #ff6600; border: none;">
                        <i class="bi bi-pencil-square me-2"></i> Editar Perfil
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 ms-2">
                        <i class="bi bi-arrow-left me-2"></i> Voltar para Lista
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-5 ms-2">
                        <i class="bi bi-trash3 me-2"></i> Excluir
                    </a>
                </div>
            </div>

        </main>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
}
